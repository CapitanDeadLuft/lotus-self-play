-- globals.lua — Umbrella runtime "globals" layer for the 16.11 Self Play port
-- (task-25). Loaded and bound from loader.lua, refreshed once per loader tick
-- from the event synthesizer's cached entity scan (no per-call entity walks).
--
-- Contract source: D:\hake\lotus\umbrella_api\GLOBALS_API.md + the 16.11 call
-- sites (Self Play.lua:939, creep_block.lua:36, waves.lua, jungle.lua:37,
-- support_camps.lua:166, self_play/prediction.lua).
--
-- Implemented here:
--   * LaneGroupsManager  — real lane waves from the client entity list; lane
--     polylines are static map data (derived from 16.11 cfg.anchors + the
--     standard Dota lane layout), lane classification from creep positions.
--   * JungleCampsManager — camps discovered from C_DOTA_NeutralSpawner client
--     entities (m_Type @0x5F0, box = centre +/- 400) with a neutral-creep
--     clustering fallback when the client list has no spawners.
--   * LIB_DAMAGE_PREDICTION — the 7-method surface used by
--     self_play/prediction.lua: begin_outgoing/collect_* + targets[unit].attacks
--     and the unit_attack table. Damage math: NPC.GetTrueDamage /
--     GetTrueMaximumDamage * NPC.GetArmorDamageMultiplier (conservative 1 when
--     unavailable). Sources: loader-recorded attack animations (near-hero).
--   * XHelpers gap-fill — XAbility.aoe_radiuses/radiuses/start_widths/
--     end_widths ability-name -> special-value-key maps (combat.lua:549-554).
--   * LaneCreepsManager / KV_LIB — documented-deferred (0 direct 16.11 call
--     sites) and therefore NOT installed; see probeRows().
--
-- Honest gaps (documented, never fabricated): ability/spell damage prediction
-- (collect_ability_* / collect_modifiers are no-ops), out-of-vision wave
-- prediction (w2s_*), stack count inference, camp gold for unseen camps.

local M = {}

local G = { api = _G }
local now = 0

-- log provider: loader binds its log(); standalone smoke runs may omit it.
local function glog(fmt)
  local f = G.log or _G.log
  if type(f) == "function" then pcall(f, fmt) end
end

-- nav map data (orders-nav task-24/25): real lane polylines + lane classification
-- + camp sites. Guarded: an older nav without these functions falls back to the
-- static lane layout / clustering below. Never cache empties (valid=false in
-- menu/lobby -> retried until the walkable map is ready).
local navMod = nil
local function navc()
  if navMod then return navMod end
  local ok, m = pcall(require, "nav")
  if ok and type(m) == "table" then navMod = m end
  return navMod
end

local navValidCache, navValidAt = false, -1e9
local function navValid()
  -- nav.stats() builds a small table with tree counts; cache the boolean for 1s
  -- so the per-tick lane/camp refresh never pays it more than once per second.
  if now - navValidAt < 1 then return navValidCache end
  navValidAt = now
  navValidCache = false
  local n = navc()
  if not n then return false end
  if type(n.stats) == "function" then
    local ok, st = pcall(n.stats)
    if ok and type(st) == "table" and st.valid == true then navValidCache = true end
    return navValidCache
  end
  navValidCache = true
  return true
end

local function A()
  return G.api or _G
end

local function ent()
  return G.ent
end

local function isTable(t)
  return type(t) == "table"
end

local function push(t, v)
  t[#t + 1] = v
end

local function reset(t)
  for i = #t, 1, -1 do t[i] = nil end
end

local function roundPos(v)
  if type(v) ~= "table" then return "nil" end
  return string.format("(%.0f,%.0f,%.0f)", tonumber(v.x) or 0, tonumber(v.y) or 0, tonumber(v.z) or 0)
end

-- ---------------------------------------------------------------------------
-- providers / small helpers
-- ---------------------------------------------------------------------------
local function groundZ(x, y)
  local g = G.groundZ
  if g then
    local ok, z = pcall(g, x, y)
    if ok and type(z) == "number" then return z end
  end
  return 128
end

local function vector(x, y, z)
  local V = _G.Vector
  if type(V) == "function" then
    local ok, v = pcall(V, x or 0, y or 0, z or 128)
    if ok then return v end
  end
  return { x = x or 0, y = y or 0, z = z or 128 }
end

local function localHero()
  local fn = G.heroFn
  if fn then
    local ok, h = pcall(fn)
    if ok and h then return h end
  end
  local hero = A().Heroes
  if hero and hero.GetLocal then
    local ok, h = pcall(hero.GetLocal)
    if ok then return h end
  end
  return nil
end

local function heroTeam()
  local h = localHero()
  if not h then return nil end
  local E = A().Entity
  if E and E.GetTeamNum then
    local ok, t = pcall(E.GetTeamNum, h)
    if ok and type(t) == "number" then return t end
  end
  return nil
end

local function absOrigin(u)
  local E = A().Entity
  if not E or not E.GetAbsOrigin then return nil end
  local ok, p = pcall(E.GetAbsOrigin, u)
  if ok and type(p) == "table" then return p end
  return nil
end

local function isEntity(u)
  local E = A().Entity
  if not E or not E.IsEntity then return u ~= nil end
  local ok, v = pcall(E.IsEntity, u)
  return ok and v == true
end

local function alive(u)
  local E = A().Entity
  if not E or not E.IsAlive then return isEntity(u) end
  local ok, v = pcall(E.IsAlive, u)
  return ok and v == true
end

local function npcName(u)
  local N = A().NPC
  if N and N.GetUnitName then
    local ok, v = pcall(N.GetUnitName, u)
    if ok and type(v) == "string" then return v end
  end
  local E = A().Entity
  if E and E.GetClassName then
    local ok, v = pcall(E.GetClassName, u)
    if ok and type(v) == "string" then return v end
  end
  return ""
end

-- ---------------------------------------------------------------------------
-- static lane polylines (data source: 16.11 cfg.anchors Self Play.lua:69-73 +
-- standard Dota 2 map lane layout; z filled from the nav ground-height grid)
-- ---------------------------------------------------------------------------
local LANE_RAW = {
  [1] = { { -6200, -6200 }, { -6200, -3800 }, { -6200, 2600 }, { -3800, 6200 }, { 6200, 6200 } },
  [2] = { { -6200, -6200 }, { -3000, -3000 }, { 3000, 3000 }, { 6200, 6200 } },
  [3] = { { -6200, -6200 }, { -3800, -6200 }, { 2600, -6200 }, { 6200, -3800 }, { 6200, 6200 } },
}
local LANE_NAME = { "top", "mid", "bot" }
local lanePaths, lanePathsReady = {}, false
local lanePathsByTeam, lanesFromNav = {}, false

local function buildLanePaths()
  local n = navc()
  local canNav = n and type(n.lanePath) == "function" and navValid()
  if lanePathsReady and (lanesFromNav or not canNav) then return lanePaths end
  if canNav then
    local byTeam, complete = {}, true
    for team = 2, 3 do
      byTeam[team] = {}
      for lane = 1, 3 do
        local ok, pts = pcall(n.lanePath, lane, team)
        if ok and type(pts) == "table" and #pts >= 2 then
          local out = {}
          for i, p in ipairs(pts) do
            out[i] = vector(p.x, p.y, p.z or groundZ(p.x, p.y))
          end
          byTeam[team][lane] = out
        else
          complete = false
        end
      end
    end
    if complete then
      lanePathsByTeam, lanesFromNav, lanePathsReady = byTeam, true, true
      lanePaths = byTeam[2]
      return lanePaths
    end
  end
  for lane, pts in pairs(LANE_RAW) do
    local out = {}
    for i, p in ipairs(pts) do out[i] = vector(p[1], p[2], groundZ(p[1], p[2])) end
    lanePaths[lane] = out
  end
  lanesFromNav = false
  lanePathsReady = true
  return lanePaths
end

local function lanePathFor(team, lane)
  buildLanePaths()
  local by = lanePathsByTeam[team]
  if by and by[lane] then return by[lane] end
  return lanePaths[lane]
end

-- lane classification from map geometry: top lane runs along y >> x, bottom
-- along x >> y, mid is the diagonal. 1800 keeps the base-area approach points
-- out of the wrong bucket after the first few seconds of a wave.
local LANE_MARGIN = 1800
local function laneOf(x, y)
  local d = x - y
  if d <= -LANE_MARGIN then return 1 end
  if d >= LANE_MARGIN then return 3 end
  return 2
end

local function isLaneCreepName(n)
  if type(n) ~= "string" or not n:find("creep", 1, true) then return false end
  if n:find("neutral", 1, true) then return false end
  return n:find("creep_lane", 1, true) ~= nil or n:find("creep_siege", 1, true) ~= nil
    or n:find("creep_flagbearer", 1, true) ~= nil or n:find("creep_melee", 1, true) ~= nil
    or n:find("creep_ranged", 1, true) ~= nil
end

local function isNeutralName(n)
  return type(n) == "string" and n:find("npc_dota_neutral", 1, true) ~= nil
    and not n:find("neutral_item", 1, true)
end

-- gold bounties for lane/neutral creeps (KV npc_units; cached)
local unitsKV, unitsKVReady = nil, false
local function bountyOf(name)
  if not unitsKVReady then
    unitsKVReady = true
    local ok, x = pcall(require, "xhelpers")
    if ok and x and x.xkv and x.xkv.GetKV then
      local ok2, all = pcall(function() return x.xkv:GetKV("npc_units") end)
      if ok2 and isTable(all) then unitsKV = all.DOTAUnits or all end
    end
  end
  local kv = unitsKV and unitsKV[name]
  if isTable(kv) then
    local lo, hi = tonumber(kv.BountyGoldMin), tonumber(kv.BountyGoldMax)
    if lo and hi then return (lo + hi) / 2 end
  end
  if type(name) == "string" then
    if name:find("creep_siege", 1, true) then return 80 end
    if name:find("creep_neutral", 1, true) then return 30 end
    if name:find("creep_lane", 1, true) then return 42 end
  end
  return 0
end

-- ---------------------------------------------------------------------------
-- LaneGroupsManager + LaneGroup/CreepRecord (16.11 consumers: Self Play.lua:939,
-- creep_block.lua:36, waves.lua)
-- ---------------------------------------------------------------------------
local LaneGroupsManager = {
  all_groups = {}, groups_ally = {}, groups_enemy = {},
  visible_ally = {}, visible_enemy = {}, invisible_enemy = {}, invisible_ally = {},
  groups_invisible_enemy = {}, w2s_ally = {}, w2s_enemy = {},
  groups_by_index_ally = {}, groups_by_index_enemy = {},
  creep_to_group = {},
  merge_distance = 800, merge_groups_update_tick = 30,
}

local laneGroupsReady = false
local groupIndex = 0

local function clusterLane(creeps)
  local groups = {}
  for _, rec in ipairs(creeps) do
    local target
    for _, g in ipairs(groups) do
      if (rec._x - g.cx) * (rec._x - g.cx) + (rec._y - g.cy) * (rec._y - g.cy) <= LaneGroupsManager.merge_distance * LaneGroupsManager.merge_distance then
        target = g
        break
      end
    end
    if not target then
      target = { items = {}, n = 0, sx = 0, sy = 0, sz = 0, cx = rec._x, cy = rec._y }
      push(groups, target)
    end
    push(target.items, rec)
    target.n = target.n + 1
    target.sx = target.sx + rec._x
    target.sy = target.sy + rec._y
    target.sz = target.sz + rec._z
    target.cx, target.cy = target.sx / target.n, target.sy / target.n
  end
  return groups
end

local function buildLaneGroups(syn, t)
  local list, n = syn.list, syn.listN or 0
  local myTeam = heroTeam()
  local paths = buildLanePaths()
  local navn = navc()
  local canLaneAt = navn and type(navn.laneAt) == "function" and navValid()
  reset(LaneGroupsManager.all_groups)
  reset(LaneGroupsManager.groups_ally)
  reset(LaneGroupsManager.groups_enemy)
  reset(LaneGroupsManager.visible_ally)
  reset(LaneGroupsManager.visible_enemy)
  reset(LaneGroupsManager.invisible_enemy)
  reset(LaneGroupsManager.invisible_ally)
  reset(LaneGroupsManager.groups_invisible_enemy)
  reset(LaneGroupsManager.w2s_ally)
  reset(LaneGroupsManager.w2s_enemy)
  LaneGroupsManager.creep_to_group = {}
  LaneGroupsManager.groups_by_index_ally = {}
  LaneGroupsManager.groups_by_index_enemy = {}
  -- bucket by team+lane
  local buckets = {}
  local seenIdx = {}
  for i = 1, n do
    local r = list[i]
    if r and isLaneCreepName(r.name) and (tonumber(r.life) or 0) == 0 then
      -- lane: nav lane classifier when the walkable map is ready (orders-nav
      -- task-24 data), static geometry classifier otherwise
      local lane
      if canLaneAt then
        local okL, l = pcall(navn.laneAt, r.x or 0, r.y or 0)
        if okL and (l == 1 or l == 2 or l == 3) then lane = l end
      end
      if not lane then lane = laneOf(r.x or 0, r.y or 0) end
      local team = tonumber(r.team) or 0
      local b = buckets[team]
      if not b then b = {}; buckets[team] = b end
      local bl = b[lane]
      if not bl then bl = {}; b[lane] = bl end
      local idx = tonumber(r.idx) or #bl + 1
      if not seenIdx[team * 100000 + idx] then
        seenIdx[team * 100000 + idx] = true
        local firstSeen = tonumber(r.firstSeen) or t
        push(bl, {
          ref = r.idn, index_ = idx, team_ = team, lane = lane,
          lane_path = lanePathFor(team, lane), lane_bounds = nil,
          spawn_time = math.floor(firstSeen / 30) * 30,
          creation_time = firstSeen, marked_dead = false,
          _x = r.x or 0, _y = r.y or 0, _z = r.z or groundZ(r.x or 0, r.y or 0),
          _name = r.name, _dormant = r.dormant and true or false,
        })
      end
    end
  end
  for team, lanes in pairs(buckets) do
    local ally = myTeam ~= nil and team == myTeam
    for lane = 1, 3 do
      local creeps = lanes[lane]
      if creeps and #creeps > 0 then
        for _, cluster in ipairs(clusterLane(creeps)) do
          groupIndex = groupIndex + 1
          -- stable id while the wave lives: lane + the entity index of the
          -- front item of the cluster (doc only needs a unique integer).
          local gid = lane * 100000 + (tonumber(cluster.items[1] and cluster.items[1].index_) or groupIndex)
          local visible = 0
          for _, rec in ipairs(cluster.items) do if not rec._dormant then visible = visible + 1 end end
          local gold = 0
          local hasSiege = false
          for _, rec in ipairs(cluster.items) do
            gold = gold + bountyOf(rec._name)
            if type(rec._name) == "string" and rec._name:find("creep_siege", 1, true) then hasSiege = true end
          end
          local group = {
            index_ = gid, is_ally_ = ally, lane = lane, type_ = 0,
            position_ = vector(cluster.cx, cluster.cy, cluster.sz / math.max(1, cluster.n)),
            creeps = cluster.items, creeps_refs = {},
            lane_path = lanePathFor(team, lane), lane_bounds = nil,
            has_siege = hasSiege,
            get_gold_bounty_cache = {
              creeps_count = cluster.n, value = gold, value_string = tostring(math.floor(gold)),
            },
            predicted_position = nil, path = nil, meeting_time_cache = nil,
          }
          for _, rec in ipairs(cluster.items) do
            push(group.creeps_refs, rec.ref)
            LaneGroupsManager.creep_to_group[rec.ref] = group
          end
          push(LaneGroupsManager.all_groups, group)
          if ally then
            push(LaneGroupsManager.groups_ally, group)
            LaneGroupsManager.groups_by_index_ally[group.index_] = group
            if visible > 0 then push(LaneGroupsManager.visible_ally, group) else push(LaneGroupsManager.invisible_ally, group) end
          else
            push(LaneGroupsManager.groups_enemy, group)
            LaneGroupsManager.groups_by_index_enemy[group.index_] = group
            if visible > 0 then push(LaneGroupsManager.visible_enemy, group) else push(LaneGroupsManager.invisible_enemy, group) end
          end
        end
      end
    end
  end
  LaneGroupsManager.groups_invisible_enemy = LaneGroupsManager.invisible_enemy
  laneGroupsReady = true
  return LaneGroupsManager
end

function LaneGroupsManager:get_group_by_creep(creep)
  return self.creep_to_group[creep]
end

function LaneGroupsManager:get_group_by_index(index)
  local i = tonumber(index)
  if not i then return nil end
  return self.groups_by_index_ally[i] or self.groups_by_index_enemy[i]
end

-- ---------------------------------------------------------------------------
-- JungleCampsManager (C_DOTA_NeutralSpawner client entities + clustering)
-- ---------------------------------------------------------------------------
local JungleCampsManager = {
  camps = {}, creep_to_camp = {}, non_attached_creeps = {}, already_deleted_creeps = {},
  _neutralSeen = {}, _campsFromSpawners = false, _discoveryAt = -100,
}

local ANCIENT_NAMES = { black_dragon = true, granite_golem = true, thunderhide = true, prowler = true }
local LARGE_NAMES = {
  centaur_khan = true, dark_troll_warlord = true, ogre_magi = true, satyr_hellcaller = true,
  polar_furbolg_ursa_warrior = true, hellbear_smasher = true, wildwing = true, mud_golem = true,
  troll_warlord = true,
}

local function campTypeOfNames(names)
  local best = 0
  for _, name in ipairs(names) do
    local short = tostring(name):gsub("^npc_dota_neutral_", "")
    for k in pairs(ANCIENT_NAMES) do
      if short:find(k, 1, true) then return 3 end
    end
    for k in pairs(LARGE_NAMES) do
      if short:find(k, 1, true) then best = math.max(best, 2) end
    end
  end
  return best
end

local function readSpawnerType(idn)
  if not G.readInt then return nil end
  local e = ent()
  if not e then return nil end
  local inst = e.instance(idn)
  if not inst or inst <= 0x10000 then return nil end
  local off = 0x5F0
  if G.schemaOffset then
    local ok, o = pcall(G.schemaOffset, "C_DOTA_NeutralSpawner", "m_Type")
    if ok and type(o) == "number" and o >= 0 then off = o end
  end
  local ok, v = pcall(G.readInt, inst, off)
  if ok and type(v) == "number" and v >= 0 and v <= 8 then return v end
  return nil
end

local function discoverCamps(t, allowScan)
  local camps = {}
  local e = ent()
  if allowScan and e and e.iter then
    local okIter, iter = pcall(function() return e.iter() end)
    if okIter and iter then
      for idn in iter do
        local dn = e.designerName(idn)
        if type(dn) == "string" then
          local low = dn:lower()
          if (low:find("spawner", 1, true) or low:find("neutral_camp", 1, true)) and not low:find("rune", 1, true) then
            local okp, pos = pcall(function() return absOrigin(idn) end)
            if okp and pos then
              push(camps, {
                ref = idn, x = tonumber(pos.x) or 0, y = tonumber(pos.y) or 0,
                z = tonumber(pos.z) or 0, type_ = readSpawnerType(idn),
                source = "spawner",
              })
            end
          end
        end
      end
    end
  end
  if #camps > 0 then
    JungleCampsManager._campsFromSpawners = true
    return camps
  end
  -- fallback: cluster neutral creeps seen so far (positions are static per camp)
  local clusters = {}
  for _, sight in pairs(JungleCampsManager._neutralSeen) do
    local target
    for _, c in ipairs(clusters) do
      local dx, dy = sight.x - c.cx, sight.y - c.cy
      if dx * dx + dy * dy <= 500 * 500 then target = c; break end
    end
    if not target then
      target = { items = {}, n = 0, sx = 0, sy = 0, sz = 0, cx = sight.x, cy = sight.y, names = {} }
      push(clusters, target)
    end
    target.n = target.n + 1
    target.sx = target.sx + sight.x
    target.sy = target.sy + sight.y
    target.sz = target.sz + (sight.z or groundZ(sight.x, sight.y))
    target.cx, target.cy = target.sx / target.n, target.sy / target.n
    push(target.names, sight.name)
  end
  for _, c in ipairs(clusters) do
    if c.n >= 2 then
      push(camps, { ref = nil, x = c.cx, y = c.cy, z = c.sz / math.max(1, c.n),
        type_ = campTypeOfNames(c.names), source = "neutral-cluster" })
    end
  end
  return camps
end

local function updateCamps(syn, t)
  JungleCampsManager._discoveryTries = JungleCampsManager._discoveryTries or 0
  if #JungleCampsManager.camps == 0 and t - (JungleCampsManager._discoveryAt or -100) > 5 then
    JungleCampsManager._discoveryAt = t
    -- the full identity-list scan costs ~7ms: try it at most 3 times, then
    -- fall back to the neutral-creep clustering path only.
    local allowScan = JungleCampsManager._discoveryTries < 3
    JungleCampsManager._discoveryTries = JungleCampsManager._discoveryTries + 1
    local found
    -- preferred source: nav.campSites() (orders-nav task-24 map data, 15-20
    -- sites, camp_type from clearing-size heuristic, side from map half)
    local navn = navc()
    if navn and type(navn.campSites) == "function" and navValid() then
      local okS, sites = pcall(navn.campSites)
      if okS and type(sites) == "table" and #sites >= 4 then
        found = {}
        for i, s in ipairs(sites) do
          if type(s) == "table" and tonumber(s.x) then
            found[#found + 1] = { x = s.x, y = s.y, z = s.z, type_ = tonumber(s.camp_type) or 1,
              side_ = tonumber(s.side), source = "nav", box = false }
          end
        end
      end
    end
    if not found then found = discoverCamps(t, allowScan) end
    if #found > 0 then
      table.sort(found, function(a, b)
        if a.x ~= b.x then return a.x < b.x end
        return a.y < b.y
      end)
      local camps = {}
      local src = found[1].source or "?"
      for i, c in ipairs(found) do
        local center = vector(c.x, c.y, c.z)
        camps[i] = {
          index_ = i, ref = c.ref, team_ = c.side_ or ((c.x + c.y < 0) and 2 or 3),
          camp_type = c.type_ or 1,
          position_ = center, position_string_ = string.format("%.0f,%.0f,%.0f", c.x, c.y, c.z),
          -- nav sites: scripts compute box-derived radius with a default when
          -- box is false (units_autofarm: `b and ... or 400`); spawner path
          -- provides the centre+-400 approximation.
          box = (c.box == false) and false or { min = vector(c.x - 400, c.y - 400, c.z), max = vector(c.x + 400, c.y + 400, c.z) },
          is_farmed_ = false, flooded_ = false, cleared_notified = false,
          creeps_all = {}, creeps_alive = {}, creeps_alive_predicted = {},
          stacks = {}, stacks_cache = { count = 1, invisible_count = 0, calculated_spawn_time = t },
          get_gold_bounty_cache = { creeps_count = 0, value = 0, value_string = "0" },
          predicted_names_by_state = { alive = {}, waiting = {} },
          resolved_groups_by_state = { alive = {}, waiting = {} },
          maximal_distance_in_camp = 450, _source = src,
          _seenCreepsAt = nil, _lastSpawn = math.floor(t / 60),
        }
      end
      JungleCampsManager.camps = camps
      JungleCampsManager._campSource = src
      glog(string.format("[globals] JungleCampsManager: %d camps discovered source=%s (camp_type/team from nav map data when available, spawner m_Type@0x5F0 otherwise)", #camps, src))
    end
  end
  -- refresh camp creeps from the cached scan
  local list, n = syn.list, syn.listN or 0
  local camps = JungleCampsManager.camps
  if #camps == 0 then return end
  -- one name map for the whole refresh (gold lookup below is O(camp creeps))
  local nameByIdx = {}
  local neutral = {}
  for i = 1, n do
    local r = list[i]
    if r then
      if r.idx then nameByIdx[r.idx] = r.name end
      if isNeutralName(r.name) and (tonumber(r.life) or 0) == 0 then neutral[#neutral + 1] = r end
    end
  end
  for _, camp in ipairs(camps) do
    reset(camp.creeps_all)
    reset(camp.creeps_alive)
    local cx, cy = camp.position_.x, camp.position_.y
    for _, r in ipairs(neutral) do
      local dx, dy = (r.x or 0) - cx, (r.y or 0) - cy
      if dx * dx + dy * dy <= 700 * 700 then
        push(camp.creeps_all, r.idn)
        if not r.dormant then push(camp.creeps_alive, r.idn) end
        JungleCampsManager.creep_to_camp[r.idn] = camp
      end
    end
    if #camp.creeps_all > 0 then
      camp._seenCreepsAt = t
      camp.is_farmed_ = false
      local gold = 0
      for _, idn in ipairs(camp.creeps_all) do
        gold = gold + bountyOf(nameByIdx[(idn % 0x8000) or 0] or "")
      end
      camp.get_gold_bounty_cache = { creeps_count = #camp.creeps_all, value = gold, value_string = tostring(math.floor(gold)) }
      camp.creeps_alive_predicted = camp.creeps_alive
    else
      if camp._seenCreepsAt and t - camp._seenCreepsAt > 30 then
        camp.is_farmed_ = true
      end
      camp.creeps_alive_predicted = camp.creeps_alive
    end
    camp.stacks_cache.calculated_spawn_time = (math.floor(t / 60) + 1) * 60
    camp.stacks_cache.count = math.max(1, #camp.creeps_all > 0 and math.ceil(#camp.creeps_all / 3) or 1)
    camp.stacks_cache.invisible_count = 0
  end
end

