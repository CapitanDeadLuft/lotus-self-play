function M.bind(ctx)
  if isTable(ctx) then
    for k, v in pairs(ctx) do G[k] = v end
  end
  G.api = G.api or _G
  _G.LaneGroupsManager = LaneGroupsManager
  _G.JungleCampsManager = JungleCampsManager
  _G.LIB_DAMAGE_PREDICTION = DP
  M.LaneGroupsManager = LaneGroupsManager
  M.JungleCampsManager = JungleCampsManager
  M.LIB_DAMAGE_PREDICTION = DP
  M.lanePaths = buildLanePaths()
  -- XHelpers.XAbility gap-fill is deferred to the first in-match update: it
  -- parses the ability KV, which must not add load-time cost (task-10 budget).
  G._xabilityPending = true
  return M
end

function M.update(syn, t)
  if not syn then return end
  now = tonumber(t) or now
  if G._xabilityPending then
    G._xabilityPending = false
    pcall(fillXAbility)
  end
  G.projectiles = syn.pending
  -- task-25 perf (reviewer budget <=10-20 ms/tick): the lane-group/camp rebuild
  -- allocates tables and walks the cached scan, so it runs at most every 0.5 s
  -- (creeps die between rebuilds; consumers already guard with Entity.IsAlive).
  -- The LIB attack table is tiny and stays per-tick so predictions are fresh.
  local buildDue = now - (G._globalsBuildAt or -1e9) >= 0.5
  if buildDue then
    G._globalsBuildAt = now
    local list, n = syn.list, syn.listN or 0
    for i = 1, n do
      local r = list[i]
      if r and isNeutralName(r.name) then
        local key = r.idx or i
        if not JungleCampsManager._neutralSeen[key] then
          JungleCampsManager._neutralSeen[key] = { x = r.x or 0, y = r.y or 0, z = r.z or 0, name = r.name, t = now }
        end
      end
    end
    local ok, err = pcall(function()
      buildLaneGroups(syn, now)
    end)
    if not ok and not M._laneErrLogged then
      M._laneErrLogged = true
      glog("[globals] LaneGroupsManager update error: " .. tostring(err))
    end
    local ok2, err2 = pcall(function()
      updateCamps(syn, now)
    end)
    if not ok2 and not M._campErrLogged then
      M._campErrLogged = true
      glog("[globals] JungleCampsManager update error: " .. tostring(err2))
    end
  end
  local ok3, err3 = pcall(function()
    refreshUnitAttack(syn, now)
  end)
  if not ok3 and not M._attackErrLogged then
    M._attackErrLogged = true
    glog("[globals] LIB_DAMAGE_PREDICTION attack refresh error: " .. tostring(err3))
  end
  -- task-25 reviewer content line: the fresh-state ctx probe cannot see the live
  -- bot state, so this rate-limited line (in-match only, every 30 s) is the
  -- ground truth for LaneGroupsManager/JungleCampsManager/LIB_DP/XAbility content.
  local hero = localHero()
  if hero and (syn.listN or 0) > 0 and (now - (G._lastGlobalsLog or -1e9) >= 30) then
    G._lastGlobalsLog = now
    local allyC, enemyC = 0, 0
    for _, g in ipairs(LaneGroupsManager.visible_ally) do allyC = allyC + #(g.creeps or {}) end
    for _, g in ipairs(LaneGroupsManager.visible_enemy) do enemyC = enemyC + #(g.creeps or {}) end
    local uaN = 0
    for _ in pairs(DP.unit_attack) do uaN = uaN + 1 end
    local xa, xaMaps = 0, 0
    local XA = _G.XHelpers and _G.XHelpers.XAbility
    if isTable(XA) then
      for _, key in ipairs({ "aoe_radiuses", "radiuses", "start_widths", "end_widths" }) do
        local t = XA[key]
        if isTable(t) then
          local n = 0
          for _ in pairs(t) do n = n + 1 end
          xa = xa + n
          if n > 0 then xaMaps = xaMaps + 1 end
        end
      end
    end
    local campSrc = JungleCampsManager._campSource or "none"
    glog(string.format("[globals] laneGroups=%d all_groups=%d visible_ally=%d visible_enemy=%d ally_creeps=%d enemy_creeps=%d camps=%d campSource=%s navValid=%s libAvail=%s unit_attack=%d attacks=%d xability=%d/maps=%d/4",
      #LaneGroupsManager.all_groups, #LaneGroupsManager.all_groups, #LaneGroupsManager.visible_ally,
      #LaneGroupsManager.visible_enemy, allyC, enemyC, #JungleCampsManager.camps, campSrc,
      tostring(navValid()), tostring(type(DP.begin_outgoing) == "function"), uaN,
      (function() local p = DP.targets[hero]; return p and #p.attacks or 0 end)(), xa, xaMaps))
  end
end

