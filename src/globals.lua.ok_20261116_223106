-- XHelpers gap-fill (combat.lua:549-554 looks the special-value KEY up by name)
-- ---------------------------------------------------------------------------
local abilityKV, abilityKVReady = nil, false
local function abilityData()
  if abilityKVReady then return abilityKV end
  abilityKVReady = true
  local x = _G.XHelpers
  if x and x.xkv and x.xkv.GetKV then
    local ok, all = pcall(function() return x.xkv:GetKV("npc_abilities") end)
    if ok and isTable(all) then abilityKV = all.DOTAAbilities or all end
  end
  return abilityKV
end

local function fillXAbility()
  local x = _G.XHelpers
  if type(x) ~= "table" then return 0 end
  local xa = x.XAbility
  if type(xa) ~= "table" then xa = {}; x.XAbility = xa end
  local aoe, radius, startW, endW = xa.aoe_radiuses, xa.radiuses, xa.start_widths, xa.end_widths
  if type(aoe) ~= "table" then aoe = {}; xa.aoe_radiuses = aoe end
  if type(radius) ~= "table" then radius = {}; xa.radiuses = radius end
  if type(startW) ~= "table" then startW = {}; xa.start_widths = startW end
  if type(endW) ~= "table" then endW = {}; xa.end_widths = endW end
  local kv = abilityData()
  if not kv then return 0 end
  local filled = 0
  for name, block in pairs(kv) do
    local values = isTable(block) and block.AbilityValues
    if isTable(values) then
      local radiusKey, aoeKey, startKey, endKey
      for key in pairs(values) do
        local low = tostring(key):lower()
        if not aoeKey and low:find("aoe_radius", 1, true) then aoeKey = key end
        if not radiusKey and low:find("radius", 1, true) and not low:find("scepter", 1, true) then radiusKey = key end
        if not startKey and (low:find("start_width", 1, true) or low == "width") then startKey = key end
        if not endKey and low:find("end_width", 1, true) then endKey = key end
      end
      if aoeKey then aoe[name] = aoeKey end
      if radiusKey then radius[name] = radiusKey end
      if startKey then startW[name] = startKey end
      if endKey then endW[name] = endKey end
      filled = filled + 1
    end
  end
  glog(string.format("[globals] XHelpers.XAbility filled from npc_abilities KV: abilities=%d aoe=%d radius=%d start_widths=%d end_widths=%d",
    filled, (function() local c=0; for _ in pairs(aoe) do c=c+1 end; return c end)(),
    (function() local c=0; for _ in pairs(radius) do c=c+1 end; return c end)(),
    (function() local c=0; for _ in pairs(startW) do c=c+1 end; return c end)(),
    (function() local c=0; for _ in pairs(endW) do c=c+1 end; return c end)()))
  return filled
end

