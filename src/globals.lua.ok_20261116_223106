-- parity rows (loader.parityProbe assembles the full [parity] block)
function M.probeRows()
  local out = {}
  local function row(s) push(out, "[parity] " .. s) end
  -- LaneGroupsManager
  local ally = LaneGroupsManager.visible_ally
  local enemy = LaneGroupsManager.visible_enemy
  row(string.format("GLOBALS LaneGroupsManager visible_ally=%d visible_enemy=%d invisible_enemy=%d all_groups=%d | %s",
    #ally, #enemy, #LaneGroupsManager.invisible_enemy, #LaneGroupsManager.all_groups,
    (#ally > 0 or #enemy > 0) and "OK" or "EMPTY(no lane creeps in scan)"))
  local sample = ally[1] or enemy[1]
  if sample then
    local refOk = false
    if sample.creeps and sample.creeps[1] then refOk = isEntity(sample.creeps[1].ref) end
    local pathOk = isTable(sample.lane_path) and #sample.lane_path >= 2
    row(string.format("GLOBALS LaneGroup lane=%s creeps=%d refOk=%s lane_path=%s name=%s | %s",
      tostring(sample.lane), #sample.creeps, tostring(refOk),
      pathOk and (#sample.lane_path .. "pts") or "nil",
      LANE_NAME[sample.lane] or "?",
      (tonumber(sample.lane) and refOk and pathOk) and "OK" or "PARTIAL"))
  end
  -- LIB_DAMAGE_PREDICTION
  local dp = DP
  local available = type(dp) == "table" and type(dp.begin_outgoing) == "function"
  row(string.format("GLOBALS LIB_DAMAGE_PREDICTION available()=%s unit_attack=%d attack_types=%s | %s",
    tostring(available), (function() local c = 0; for _ in pairs(dp.unit_attack) do c = c + 1 end; return c end)(),
    dp.attack_types and (tostring(dp.attack_types.melee) .. "/" .. tostring(dp.attack_types.ranged)) or "nil",
    available and "OK" or "FAIL"))
  local hero = localHero()
  if available and hero then
    local okP = pcall(function()
      dp:begin_outgoing(hero, 1, 2)
      dp:collect_attacks(hero, true)
      dp:collect_predictions(hero)
      dp:collect_projectiles(hero)
      dp:collect_ability_projectiles(hero)
      dp:collect_ability_animations(hero)
      dp:collect_modifiers(hero)
    end)
    local entry = dp.targets[hero]
    local attacks = (okP and entry and isTable(entry.attacks)) and #entry.attacks or -1
    row(string.format("GLOBALS LIB_DAMAGE_PREDICTION targets[hero].attacks=%d | %s",
      attacks, okP and attacks >= 0 and "OK" or "ERR"))
    local first = okP and entry and entry.attacks and entry.attacks[1]
    if first then
      row(string.format("GLOBALS LIB_DAMAGE_PREDICTION attack sample{attacker=%s t=%.2f dmg=%.1f max=%.1f tower=%s} | OK",
        tostring(npcName(first.attacker)), tonumber(first.time_to_damage) or 0,
        tonumber(first.damage) or 0, tonumber(first.max_damage) or 0, tostring(first.is_tower)))
    end
  end
  -- JungleCampsManager
  local camps = JungleCampsManager.camps
  row(string.format("GLOBALS JungleCampsManager camps=%d source=%s | %s", #camps,
    tostring(JungleCampsManager._campSource or "none"),
    #camps >= 10 and "OK" or (#camps > 0 and "PARTIAL(<10)" or "EMPTY")))
  local camp = camps[1]
  if camp then
    row(string.format("GLOBALS Camp index_=%s team_=%s type=%s pos=%s farmed=%s box=%s creeps_alive=%d | %s",
      tostring(camp.index_), tostring(camp.team_), tostring(camp.camp_type), roundPos(camp.position_),
      tostring(camp.is_farmed_), isTable(camp.box) and "set" or tostring(camp.box), #camp.creeps_alive,
      (tonumber(camp.team_) and tonumber(camp.camp_type) ~= nil) and "OK" or "PARTIAL"))
  end
  -- nav map data (orders-nav task-24): lane polylines + camp sites used above
  local navn = navc()
  if navn and type(navn.laneRoutes) == "function" then
    local okR, routes = pcall(navn.laneRoutes)
    local okC, sites = pcall(navn.campSites)
    local r21 = okR and type(routes) == "table" and routes[2] and routes[2][1]
    row(string.format("NAV laneRoutes=%s team2.lane1.pts=%s campSites=%s statsValid=%s lanesFromNav=%s | %s",
      okR and "present" or "ERR", tostring(r21 and #r21 or 0),
      tostring(okC and type(sites) == "table" and #sites or "nil"), tostring(navValid()),
      tostring(lanesFromNav),
      (okR and r21 and #r21 > 1 and okC and type(sites) == "table" and #sites >= 10) and "OK" or "PARTIAL(nav not ready)"))
  else
    row("NAV laneRoutes/campSites not present (old nav in this process; static fallback active)")
  end
  -- XHelpers
  local x = _G.XHelpers
  if isTable(x) then
    local xa = x.XAbility or {}
    local nAoe, nRad, nStart, nEnd = 0, 0, 0, 0
    for _ in pairs(xa.aoe_radiuses or {}) do nAoe = nAoe + 1 end
    for _ in pairs(xa.radiuses or {}) do nRad = nRad + 1 end
    for _ in pairs(xa.start_widths or {}) do nStart = nStart + 1 end
    for _ in pairs(xa.end_widths or {}) do nEnd = nEnd + 1 end
    row(string.format("GLOBALS XHelpers keys=xkv,XAbility,GetScript XAbility aoe=%d radius=%d start=%d end=%d | %s",
      nAoe, nRad, nStart, nEnd, (nAoe + nRad + nStart) > 0 and "OK" or "PARTIAL"))
  end
  -- documented-deferred
  row("GLOBALS LaneCreepsManager missing=expected(documented-deferred: 0 direct 16.11 call sites)")
  row("GLOBALS KV_LIB missing=expected(documented-deferred: 0 direct 16.11 call sites)")
  return out
end

