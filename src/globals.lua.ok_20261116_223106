end

function DP:calculate_damage(attacker)
  return trueDamage(attacker, false)
end

function DP:calculate_maximum_damage(attacker)
  return trueDamage(attacker, true)
end

function DP:mitigate_damage(_attacker, target, damage)
  return (tonumber(damage) or 0) * armorMult(target)
end

function DP:calculate_range_attack_time(attacker, target)
  local N = A().NPC
  local point, speed = 0.0, nil
  if N then
    if N.GetAttackAnimPoint then local ok, v = pcall(N.GetAttackAnimPoint, attacker); if ok and type(v) == "number" then point = v end end
    if N.GetAttackProjectileSpeed then local ok, v = pcall(N.GetAttackProjectileSpeed, attacker); if ok and type(v) == "number" and v > 0 then speed = v end end
  end
  local travel = 0.0
  local a, b = absOrigin(attacker), target and absOrigin(target)
  if speed and a and b then
    local dx, dy = (a.x or 0) - (b.x or 0), (a.y or 0) - (b.y or 0)
    travel = math.sqrt(dx * dx + dy * dy) / speed
  end
  return point + travel
end

function DP:calculate_melee_attack_time(attacker)
  local N = A().NPC
  if N and N.GetAttackAnimPoint then
    local ok, v = pcall(N.GetAttackAnimPoint, attacker)
    if ok and type(v) == "number" then return v end
  end
  return 0.3
end

function DP:calculate_need_go(target, attackTime)
  local hp = 0
  local E = A().Entity
  if E and E.GetHealth then local ok, v = pcall(E.GetHealth, target); if ok and type(v) == "number" then hp = v end end
  local p = self.targets[target]
  local incoming = 0
  for _, attack in ipairs(p and p.attacks or {}) do incoming = incoming + (attack.damage or 0) end
  return math.max(0, hp - incoming), attackTime or 0
end

function DP:target_have_bm(target)
  local N = A().NPC
  if N and N.HasModifier then
    local ok, v = pcall(N.HasModifier, target, "modifier_item_blade_mail")
    if ok and v == true then return true end
  end
  return false
end

local function refreshUnitAttack(syn, t)
  local src = syn.unitAttack
  local out = {}
  if src then
    for _, e in pairs(src) do
      if isTable(e) and tonumber(e.due) and t - (tonumber(e.stamp) or 0) < 6 then
        out[e.source] = {
          source = e.source, target = e.target, time_to_damage = e.due, is_tower = e.is_tower == true,
          start_anim_time = e.swingStart, castpoint = e.castpoint,
          type_ = e.kind, attack_type = e.kind,
        }
      end
    end
  end
  DP.unit_attack = out
  -- prune predictions occasionally so targets[] doesn't grow forever
  if (G.frame and G.frame() or 0) % 600 == 0 then
    local keep = {}
    for key, p in pairs(DP.targets) do
      if p.hp ~= nil or #p.attacks > 0 then keep[key] = p end
    end
    DP.targets = keep
  end
end

