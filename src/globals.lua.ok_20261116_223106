local DP = {
  targets = {}, unit_attack = {},
  attack_types = { melee = 0, ranged = 1, projectile = 5 },
  attack_type_to_name = { [0] = "melee", [1] = "ranged", [5] = "projectile" },
  supports_outgoing_exact = true, supports_tower_attacks = true,
  filter_dead_attacks = true, loss_spread = 0,
  my_units = {}, my_units_info = {},
}

local function trueDamage(attacker, maximum)
  local N = A().NPC
  if not N then return 0 end
  local v = 0
  if N.GetTrueDamage then
    local ok, d = pcall(N.GetTrueDamage, attacker)
    if ok and type(d) == "number" and d > 0 then v = d end
  end
  if maximum and N.GetTrueMaximumDamage then
    local ok, d = pcall(N.GetTrueMaximumDamage, attacker)
    if ok and type(d) == "number" and d > v then v = d end
  end
  return v
end

local function armorMult(target)
  local N = A().NPC
  if not N or not N.GetArmorDamageMultiplier then return 1 end
  local ok, m = pcall(N.GetArmorDamageMultiplier, target)
  if ok and type(m) == "number" and m > 0 and m < 8 then return m end
  return 1
end

local function damageFor(attacker, target)
  local base = trueDamage(attacker, false)
  if base <= 0 then return 0, 0 end
  local mult = armorMult(target)
  local maximum = trueDamage(attacker, true)
  if maximum < base then maximum = base end
  return base * mult, maximum * mult
end

local function freshPrediction(target, hp, maxHp)
  return {
    hp = hp, max_hp = maxHp, attacks = {}, modifiers = {},
    outgoing_policy = hp and "outgoing_exact" or nil,
    outgoing_hp_unknown = hp == nil,
    begin_count = 1, frame_seq = (G.frame and G.frame()) or 0,
  }
end

function DP:begin(target)
  local p = freshPrediction(target, nil, nil)
  self.targets[target] = p
  return p
end

function DP:begin_outgoing(target, hp, max_hp)
  local p = freshPrediction(target, tonumber(hp) or 0, tonumber(max_hp) or 0)
  self.targets[target] = p
  return p
end

local function addAttack(p, entry, target)
  local due = tonumber(entry.time_to_damage)
  if not due or due <= now - 0.25 or due > now + 4 then return end
  for _, have in ipairs(p.attacks) do
    if have.attacker == entry.source then return end   -- one entry per attacker
  end
  local dmg, maximum = damageFor(entry.source, target)
  if dmg <= 0 then return end
  push(p.attacks, {
    attacker = entry.source, time_to_damage = due, damage = dmg, max_damage = maximum,
    is_tower = entry.is_tower == true, is_risk = false,
    type = (entry.kind == 1 and 1) or 0, start_anim_time = entry.start_anim_time,
  })
end

function DP:collect_attacks(target, _exact)
  local p = self.targets[target]
  if not p then p = self:begin(target) end
  for _, entry in pairs(self.unit_attack) do
    if entry.target == target then addAttack(p, entry, target) end
  end
  table.sort(p.attacks, function(a, b) return a.time_to_damage < b.time_to_damage end)
end

function DP:collect_predictions(_target)
  -- gap: heroes already locked onto the target are covered by unit_attack above
end

function DP:collect_projectiles(target)
  local p = self.targets[target]
  if not p then p = self:begin(target) end
  local pending = G.projectiles
  if not pending then return end
  for _, proj in pairs(pending) do
    if isTable(proj) and proj.target == target and tonumber(proj.due) and proj.due > now - 0.25 then
      local have = false
      for _, attack in ipairs(p.attacks) do
        if attack.attacker == proj.source then have = true; break end
      end
      if not have then
        local dmg, maximum = damageFor(proj.source, target)
        if dmg > 0 then
          push(p.attacks, {
            attacker = proj.source, time_to_damage = proj.due, damage = dmg, max_damage = maximum,
            is_tower = false, is_risk = false, type = 5,
          })
        end
      end
    end
  end
end

function DP:collect_ability_projectiles(_target)
  -- known gap: targeted spell projectiles are not synthesised (no USERMSG hook)
end

function DP:collect_ability_animations(_target)
