end
-- install a fallback only when the namespace owner (api.lua) did not define
-- the function yet. Keeps api.lua the source of truth (PM ruling C1).
local logSeen = {}
local function logOnce(key, msg, everyN)
  local n = logSeen[key]
  if n == nil then
    logSeen[key] = 1
    log(msg)
  elseif everyN and n % everyN == 0 then
    log(msg)
  end
  logSeen[key] = (logSeen[key] or 0) + 1
end
local function define(nsname, fname, fn)
  local ns = rawget(_G, nsname)
  if not ns then ns = {}; _G[nsname] = ns end
  if rawget(ns, fname) == nil then ns[fname] = fn end
  return ns[fname]
end
