    out[#out + 1] = string.format("utf8.char(0x41,0x4E2D,0x1F600)=%d bytes (%s)",
      (ok and type(v) == "string") and #v or 0, ok and "ok" or "ERR")
  end
  return out
end

-- dump every entity identity/designer name once: the diag script uses this to
-- prove whether projectile/particle entities exist in the client entity list.
function M.dumpEntityNames()
  local out, seen = {}, {}
  for idn in ent.iter() do
    local nm = ent.designerName(idn) or "<nil>"
    local idx = (ri(idn, 0x10) or -1) % 0x8000
    local inst = ent.instance(idn)
    local act = inst and ri(inst, oAct) or nil
    local key = nm .. "#" .. idx
    if not seen[key] then
      seen[key] = true
      out[#out + 1] = string.format("%s idx=%d inst=%s act=%s", nm, idx,
        inst and string.format("0x%X", inst) or "nil", tostring(act))
    end
  end
  return out
end

-- raw controller order-queue probe: dumps what the game stores when a human
-- order arrives (used once to reverse the CUnitOrders layout from a QA run)
function M.dumpOrderQueue()
  local ctrl = localController()
  if not ctrl then return {} end
  local out = { string.format("ctrl=0x%X seq=%s", ctrl, tostring(ri(ctrl, 0x9B8))) }
  local base = ctrl + 0x9A0
  if rdok(base, 24) then
    local vals = {}
    for i = 0, 5 do vals[#vals + 1] = tostring(ri(base, i * 4)) end
    out[#out + 1] = "m_unitorders raw: " .. table.concat(vals, " ")
    local p = rptr(base, 8)
    local size = ri(base, 0x10)
    out[#out + 1] = string.format("guess ptr=0x%X size=%s", p or 0, tostring(size))
    if p and p > 0x10000 and size and size > 0 and size < 64 and rdok(p, size * 0x58) then
      local last = p + (size - 1) * 0x58
      local words = {}
      for i = 0, 21 do words[#words + 1] = string.format("%d", ri(last, i * 4) or 0) end
      out[#out + 1] = "last order words: " .. table.concat(words, ",")
      local floats = {}
      for i = 0, 21 do floats[#floats + 1] = string.format("%.2f", rf(last, i * 4) or 0) end
      out[#out + 1] = "last order floats: " .. table.concat(floats, ",")
    end
  else
    out[#out + 1] = "m_unitorders not readable"
  end
  return out
end

