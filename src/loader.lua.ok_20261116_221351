-- memory-read guards -------------------------------------------------------
-- api.lua already declares `API_MBI` + VirtualQuery with its own struct type;
-- LuaJIT resolves ffi.C symbols once, so a second struct type breaks the call
-- ("cannot convert struct N to struct M*"). Reuse api.lua's type (and fall
-- back to declaring our own only when api.lua's declaration is unavailable).
local mbiTypeName = "API_MBI"
do
  local ok = pcall(ffi.typeof, mbiTypeName)
  if not ok then
    local ok2 = pcall(ffi.cdef, [[typedef struct { void* BaseAddress; void* AllocationBase;
      unsigned long AllocProtect; size_t RegionSize; unsigned long State; unsigned long Protect;
      unsigned long Type; } EV_MBI;]])
    if ok2 and pcall(ffi.typeof, "EV_MBI") then mbiTypeName = "EV_MBI" end
  end
end
local evRegions, evRegionN = {}, 0
-- cast the symbol to a raw signature so the prototype's struct type (api.lua's
-- API_MBI) can never reject our MBI pointer again
local VQ = ffi.cast("size_t (*)(void*, void*, size_t)", C.VirtualQuery)
local function rdok(p, n)
  if p == nil then return false end
  local a = tonumber(ffi.cast("uintptr_t", p))
  if a < 0x10000 or a > 0x7FFFFFFFFFFF then return false end
  local need = a + (n or 4)
  for i = 1, evRegionN do
    local r = evRegions[i]
    if a >= r[1] and need <= r[2] then return true end
  end
  local mbi = ffi.new(mbiTypeName)
  if VQ(ffi.cast("void*", a), ffi.cast("void*", mbi), ffi.sizeof(mbi)) == 0 then return false end
  if tonumber(mbi.State) ~= 0x1000 then return false end
  local prot = tonumber(mbi.Protect)
  if not (prot == 0x02 or prot == 0x04 or prot == 0x08 or prot == 0x20 or prot == 0x40) then return false end
  local b = tonumber(ffi.cast("uintptr_t", mbi.BaseAddress))
  local e = b + tonumber(mbi.RegionSize)
  if evRegionN < 48 then evRegionN = evRegionN + 1; evRegions[evRegionN] = { b, e }
  else evRegions[(evRegionN % 48) + 1] = { b, e } end
  return need <= e
end

