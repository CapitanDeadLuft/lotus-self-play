local function stubNS(name, defaults)
  local existing = rawget(_G, name)
  if existing ~= nil then return existing end
  local ns = defaults or {}
  setmetatable(ns, { __index = function(t, k)
    if type(k) ~= "string" then return nil end
    local key = name .. "." .. k
    local v = stubValue(k)
    local f = function() return v end
    rawset(t, k, f)
    if not stubSeen[key] then
      stubSeen[key] = true
      log(string.format("stubNS: %s.%s -> %s (no owner implementation)", name, k, type(v)))
    end
    return f
