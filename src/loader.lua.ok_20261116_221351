-- game KV (attack animation point + projectile speed per unit name) --------
-- Loaded once, on script load, outside of match time: parsing these costs a
-- few hundred ms and must not land inside the first creep wave.
local KV = { hero = nil, unit = nil, loaded = false, cache = {} }
local function kvLoad()
  if KV.loaded then return end
  KV.loaded = true
  local okj, json = pcall(require, "json")
  if not okj then log("events: json module missing, KV timing data unavailable"); return end
  local t0 = os.clock()
  local okh, h = pcall(json.loadfile, "D:\\hake\\lotus\\gamedata\\npc_heroes.json")
  local oku, u = pcall(json.loadfile, "D:\\hake\\lotus\\gamedata\\npc_units.json")
  KV.hero = (okh and type(h) == "table") and h or nil
  KV.unit = (oku and type(u) == "table") and u or nil
  log(string.format("events: game KV loaded in %.0fms hero=%s unit=%s",
    (os.clock() - t0) * 1000, tostring(KV.hero ~= nil), tostring(KV.unit ~= nil)))
end
local function kvNum(name, field, fallback)
  local key = name .. "\1" .. field
  local v = KV.cache[key]
  if v ~= nil then return v end
  kvLoad()
  local best
  for _, tbl in ipairs({ KV.hero, KV.unit }) do
    if tbl then
      local cur, depth, seen = tbl[name], 0, {}
      while cur and depth < 6 do
        local x = cur[field]
        if x ~= nil and x ~= "" then
          local n = tonumber(x)
          if n then best = n; break end
        end
        local base = cur.BaseClass or cur.include_keys_from
        if not base or base == name or seen[base] then break end
        seen[base] = true
        cur = tbl[base]; depth = depth + 1
      end
      if best then break end
    end
  end
  if best == nil then best = fallback end
  KV.cache[key] = best
  return best
end
local unitStatCache = {}
-- KV spawn names differ from some client designer names. Live evidence: lane
-- creeps are named generically "npc_dota_creep_lane" (no KV entry, melee and
-- ranged share the name), so the engine AttackCapabilities bit decides
-- melee/ranged and supplies the fallback values from npc_units.txt:
-- ranged lane creep: ProjectileSpeed 900 / AttackAnimationPoint 0.5;
-- melee 0 / 0.467; tower 750 / 0.6; siege 0 / 0.7.
local function unitStatCandidates(name)
  local out = { name }
  local variant = name:gsub("creep_lane_bad_", "creep_badguys_"):gsub("creep_lane_good_", "creep_goodguys_")
  if variant ~= name then out[#out + 1] = variant end
  local side, kind = name:match("^npc_dota_creep_lane_([a-z]+)_(.+)$")
  if side and kind then
    local s = (side == "bad") and "badguys" or (side == "good") and "goodguys" or side
    out[#out + 1] = "npc_dota_creep_" .. s .. "_" .. kind
  end
  return out
end
local function unitStats(name, ranged)
  local cacheKey = (ranged and name .. "\1ranged") or (name .. "\1melee")
  local s = unitStatCache[cacheKey]
  if s then return s end
  local speed, point, range
  for _, cand in ipairs(unitStatCandidates(name)) do
    local sp = kvNum(cand, "ProjectileSpeed", nil)
    local pt = kvNum(cand, "AttackAnimationPoint", nil)
    local rg = kvNum(cand, "AttackRange", nil)
    if sp ~= nil or pt ~= nil or rg ~= nil then
      speed = speed or sp
      point = point or pt
      range = range or rg
      if speed ~= nil and point ~= nil then break end
    end
  end
  if not speed or not point then
    local n = name:lower()
    if n:find("ranged", 1, true) then speed, point = speed or 900, point or 0.5
    elseif n:find("siege", 1, true) then speed, point = speed or 0, point or 0.7
    elseif n:find("melee", 1, true) then speed, point = speed or 0, point or 0.467
    elseif n:find("tower", 1, true) or n:find("building", 1, true) then speed, point = speed or 750, point or 0.6
    elseif n:find("npc_dota_creep", 1, true) or n:find("npc_dota_neutral", 1, true) then
      if ranged then speed, point = speed or 900, point or 0.5
      else speed, point = speed or 0, point or 0.467 end
    elseif ranged then speed, point = speed or 900, point or 0.5
    else speed, point = speed or 0, point or 0.3 end
  end
  s = { speed = speed or 0, point = point or 0.3, range = range or 500 }
  if s.speed < 0 then s.speed = 0 end
  if s.point <= 0 or s.point > 2 then s.point = 0.3 end
  unitStatCache[cacheKey] = s
  return s
end

