      out[#out + 1] = string.format("Modifier.GetState(%s)=%s,%s (%s)", ent.designerName(sample),
        tostring(a), tostring(b), ok and "ok" or "ERR")
      if rawget(mod, "GetDieTime") then
        local ok2, v = pcall(mod.GetDieTime, sample)
        out[#out + 1] = string.format("Modifier.GetDieTime(%s)=%s (%s)",
          ent.designerName(sample), tostring(v), ok2 and "ok" or "ERR")
      end
    else
      out[#out + 1] = "Modifier.GetState sample: no modifier entity on the map"
    end
  end
  local tw = rawget(_G, "Tower")
  if tw and rawget(tw, "GetAttackTarget") then
    local sample
    for idn in ent.iter() do
      local nm = ent.designerName(idn)
