-- task-25 diag helper: build nav + scan + globals state INSIDE the calling Lua
-- state. Needed because diag_api_parity_ctx.lua requires loader in a fresh Lua
-- state that never runs a tick: without this, global content rows (lane groups,
-- camps, groundZ, LIB attacks) measure a virgin module, not the live session.
function M.refreshWorld()
  local now = gameTime()
  local hero = localHero()
  local hx, hy = 0, 0
  if hero then
    local okp, p = pcall(_G.Entity.GetAbsOrigin, hero)
    if okp and p then hx, hy = p.x or 0, p.y or 0 end
  end
  if navmod then
    local okv, st = pcall(function() return navmod.stats and navmod.stats().valid end)
    if not okv or not st then pcall(navmod.rescan) end
    pcall(navmod.refresh, hx, hy)
  end
  if globals and BISECT.synth then
    local s = M.script or {}
    local okSc, errSc = pcall(scan, s, now)
    if not okSc then logOnce("refreshWorld.scan", "refreshWorld scan error: " .. tostring(errSc)) end
    local okG, errG = pcall(globals.update, SYN, now)
    if not okG then logOnce("refreshWorld.globals", "refreshWorld globals error: " .. tostring(errG)) end
  end
  return true
end

-- task-23/task-25: loader-context parity rows for diag_api_parity_ctx.lua.
-- Ordered array of "[parity] ..." strings; api-core's ctx diag logs each row
-- between its === API_PARITY BEGIN/END === markers.
function M.parityProbe()
  -- build the world state first: ctx runs in a fresh Lua state, so without this
  -- every content row below would describe an untouched module.
  pcall(M.refreshWorld)
  local out = {}
  local function row(s) out[#out + 1] = "[parity] " .. s end
  row("context loader=true (api registered + loader shims active)")
  local nowT = gameTime()
  local hero = localHero()
  local heroPos = hero and _G.Entity.GetAbsOrigin(hero) or nil
  local myTeamG = hero and tonumber(ru8(ent.instance(hero), oTeam)) or nil
  -- ---- Item.* (real C_DOTA_Item reads + KV cost; GetStockCount documented STUB)
  local item
  if hero and _G.NPC and _G.NPC.GetItemByIndex then
    for slot = 0, 15 do
      local ok, it = pcall(_G.NPC.GetItemByIndex, hero, slot)
      if ok and it then item = it; break end
    end
  end
  if item then
    local I = _G.Item
    local function q(fn)
      if not (I and rawget(I, fn)) then return "MISSING" end
      local ok, v = pcall(I[fn], item)
      if not ok then return "ERR" end
      return tostring(v)
    end
    row(string.format("Item.* item=%s charges=%s secondary=%s enabled=%s cost=%s ownerID=%s stackable=%s sellable=%s combineLocked=%s recipe=%s stock=99(STUB) | %s",
      ent.designerName(item) or "?", q("GetCurrentCharges"), q("GetSecondaryCharges"), q("IsItemEnabled"),
      q("GetCost"), q("GetPlayerOwnerID"), q("IsStackable"), q("IsSellable"),
      q("IsCombineLocked"), q("IsRecipe"),
      (q("GetCost") ~= "0" and q("IsItemEnabled") == "true") and "OK" or "PARTIAL"))
  else
    row("Item.* sample=none (hero has no item identity yet; rows need gt>0 with an item)")
  end
  -- ---- Modifier.* (CDOTA_Buff raw object via NPC.GetModifiers; same-epoch probe)
  local buff = nil
  local buffName = ""
  if hero and _G.NPC and _G.NPC.GetModifiers then
    local ok, list = pcall(_G.NPC.GetModifiers, hero)
    if ok and type(list) == "table" then
      for _, m in ipairs(list) do
        if m then buff = m; break end
      end
    end
  end
  if buff then
    local M2 = _G.Modifier
    local function qm(fn)
      if not (M2 and rawget(M2, fn)) then return "MISSING" end
      local ok, v = pcall(M2[fn], buff)
      if not ok then return "ERR" end
      if type(v) == "number" then return string.format("%.3f", v) end
      return tostring(v)
    end
    do
      local ok, v = pcall(M2.GetName, buff)
      if ok and type(v) == "string" then buffName = v end
    end
    local offCre = (function() local ok, v = pcall(sch.offsetOf, "CDOTA_Buff", "m_flCreationTime"); return (ok and type(v) == "number") and v or -1 end)()
    local offDie = (function() local ok, v = pcall(sch.offsetOf, "CDOTA_Buff", "m_flDieTime"); return (ok and type(v) == "number") and v or -1 end)()
    local offDur = (function() local ok, v = pcall(sch.offsetOf, "CDOTA_Buff", "m_flDuration"); return (ok and type(v) == "number") and v or -1 end)()
    local creV = tonumber(qm("GetCreationTime")) or -1
    -- raw evidence at the api-proven constants (api.lua buffRemaining reads 0x64)
    local raw54 = rd(buff, 0x54, "f32")
    local raw60 = rd(buff, 0x60, "f32")
    local raw64 = rd(buff, 0x64, "f32")
    local raw84 = rd(buff, 0x84, "i32")
    row(string.format("Modifier.* name=%s cre=%s die=%s dur=%s stack=%s state=%s | offsets cre=0x%X die=0x%X dur=0x%X now=%.3f epoch=%s | raw@api-const f32[0x54]=%s f32[0x60]=%s f32[0x64]=%s i32[0x84]=%s | CONTRACT-SAMPLE(pair rows across two probes >=20s apart: cre must stay static, now advances; die=now+remaining for timed buffs)",
      buffName, qm("GetCreationTime"), qm("GetDieTime"), qm("GetDuration"), qm("GetStackCount"), qm("GetState"),
      offCre, offDie, offDur, nowT,
      (creV > nowT - 3600 and creV > 0) and "same-as-now" or "OTHER/NOT-TIMESTAMP",
      tostring(raw54), tostring(raw60), tostring(raw64), tostring(raw84)))
  else
    row("Modifier.* sample=none (NPC.GetModifiers(hero) returned no buffs)")
  end
  -- ---- World.GetGroundZ (nav ground-height grid; UNVERIFIED doc -> real values)
  if _G.World and rawget(_G.World, "GetGroundZ") then
    local pts = { { "hero", (heroPos and heroPos.x) or 0, (heroPos and heroPos.y) or 0 },
                  { "p2", 0, 0 }, { "p3", -4000, -3000 }, { "p4", 3000, 2500 } }
    local parts, varied, first = {}, false, nil
    for _, p in ipairs(pts) do
      local ok, z = pcall(_G.World.GetGroundZ, p[2], p[3])
      if ok and type(z) == "number" then
        parts[#parts + 1] = string.format("%s(%.0f,%.0f)=%.0f", p[1], p[2], p[3], z)
        if first == nil then first = z elseif math.abs(z - first) > 1 then varied = true end
      else
        parts[#parts + 1] = p[1] .. "=ERR"
      end
    end
    row(string.format("World.GetGroundZ %s | varied=%s | %s", table.concat(parts, " "), tostring(varied),
      varied and "OK(nav height grid)" or "STUB(flat value; nav grid missing)"))
  else
    row("World.GetGroundZ MISSING")
  end
  -- ---- FogOfWar (api-owned: api.lua:2239-2256; loader's define is inert because
  -- api registers first). api semantics: IsPointVisible(pointTable), IsVisible(entity).
  if _G.FogOfWar and rawget(_G.FogOfWar, "IsPointVisible") then
    local x, y, z = (heroPos and heroPos.x) or 0, (heroPos and heroPos.y) or 0, (heroPos and heroPos.z) or 0
    local ok, v = pcall(_G.FogOfWar.IsPointVisible, { x = x, y = y, z = z })
    local ok2, v2 = pcall(_G.FogOfWar.IsVisible, hero or 0)
    row(string.format("FogOfWar.IsPointVisible(point)=%s IsVisible(hero)=%s raises=%s | owner=api(api.lua:2239-2256) STUB(documented: enemy-vision approximation, false-conservative) | %s",
      tostring(ok and v), tostring(ok2 and v2), tostring(not ok or not ok2),
      (ok and type(v) == "boolean") and "OK(no-raise)" or "ERR"))
  else
    row("FogOfWar.IsPointVisible MISSING")
  end
  -- ---- globals layer rows (LaneGroupsManager/LIB_DAMAGE_PREDICTION/Jungle/XHelpers)
  if globals and globals.probeRows then
    local ok, rows = pcall(globals.probeRows)
    if ok and type(rows) == "table" then
      for _, r in ipairs(rows) do out[#out + 1] = r end
    else
      row("GLOBALS probe error: " .. tostring(rows))
    end
  else
    row("GLOBALS layer not bound")
  end
  -- ---- ACCEPTANCE rows (lane-phase criteria; Lead compares sample1/sample2)
  local function num(fn, arg)
    if not fn then return "nil" end
    local ok, v = pcall(fn, arg)
    if ok and type(v) == "number" then return string.format("%.2f", v) end
    return "nil"
  end
  local lastHits = (hero and _G.NPC.GetLastHits) and num(_G.NPC.GetLastHits, hero) or "nil"
  local denies = (hero and _G.NPC.GetDenies) and num(_G.NPC.GetDenies, hero) or "nil"
  local xp = (hero and _G.Hero.GetCurrentXP) and num(_G.Hero.GetCurrentXP, hero) or "nil"
  local lvl = (hero and _G.NPC.GetCurrentLevel) and num(_G.NPC.GetCurrentLevel, hero) or "nil"
  local gold = (hero and _G.Player.GetGold) and num(_G.Player.GetGold, hero) or "nil"
  local attacking, running = "nil", "nil"
  if hero then
    if _G.NPC.IsAttacking then local ok, v = pcall(_G.NPC.IsAttacking, hero); if ok then attacking = tostring(v) end end
    if _G.NPC.IsRunning then local ok, v = pcall(_G.NPC.IsRunning, hero); if ok then running = tostring(v) end end
  end
  local distWave, distAlly = -1, -1
  if heroPos then
    local function consider(list)
      for _, grp in ipairs(list or {}) do
        for _, rec in ipairs(grp.creeps or {}) do
          local p = _G.Entity.GetAbsOrigin(rec.ref)
          if p then
            local dx, dy = (p.x or 0) - (heroPos.x or 0), (p.y or 0) - (heroPos.y or 0)
            local d = math.sqrt(dx * dx + dy * dy)
            if distWave < 0 or d < distWave then distWave = d end
          end
        end
      end
    end
    if globals and globals.LaneGroupsManager then
      consider(globals.LaneGroupsManager.visible_ally)
      consider(globals.LaneGroupsManager.visible_enemy)
    end
    for i = 1, SYN.listN do
      local r = SYN.list[i]
      if r and r.name and r.name:find("npc_dota_hero") and r.idn ~= hero and myTeamG and r.team == myTeamG then
        local p = _G.Entity.GetAbsOrigin(r.idn)
        if p then
          local dx, dy = (p.x or 0) - (heroPos.x or 0), (p.y or 0) - (heroPos.y or 0)
          local d = math.sqrt(dx * dx + dy * dy)
          if distAlly < 0 or d < distAlly then distAlly = d end
        end
      end
    end
  end
  row(string.format("ACCEPTANCE gt=%.1f lastHits=%s denies=%s xp=%s lvl=%s gold=%s distWave=%.0f distAlly=%.0f attacking=%s running=%s",
    nowT, lastHits, denies, xp, lvl, gold, distWave, distAlly, attacking, running))
  return out
end

return M