  local nc = rawget(_G, "NetChannel")
  if nc and rawget(nc, "GetAvgLatency") then
    local ok, r = pcall(nc.GetAvgLatency, enums.Flow and enums.Flow.FLOW_OUTGOING or 0)
    if ok then v = tonumber(r) end
  end
  if not v or v ~= v or v < 0 or v > 2 then
    v = 0
    logOnce("ev.lag", "[ev] lag=unknown (NetChannel.GetAvgLatency unavailable -> lag_compensation_time=0)")
  end
  SYN.latency = v
  return v
end

-- callback dispatch ---------------------------------------------------------
local function fire(s, name, arg)
  local fn = s[name]; if not fn then return end
  local tf = os.clock()
  local ok, err = pcall(fn, arg)
  local st = SYN.stats
  local dt = os.clock() - tf
  st.fireCost = (st.fireCost or 0) + dt
  st.fireByName[name] = (st.fireByName[name] or 0) + dt
  st.pollFire[name] = (st.pollFire[name] or 0) + dt
  if not ok then
    st.errors = st.errors + 1
    if SYN._errLogged < 6 then SYN._errLogged = SYN._errLogged + 1; log("events: " .. name .. " error: " .. tostring(err)) end
    return
  end
  st.fires[name] = (st.fires[name] or 0) + 1
  if SYN.diagHook then
    local ok2, err2 = pcall(SYN.diagHook, name, arg)
    if not ok2 and SYN._errLogged < 6 then SYN._errLogged = SYN._errLogged + 1; log("events: diagHook error: " .. tostring(err2)) end
  end
end

-- scheduled attack projectiles ---------------------------------------------
local function scheduleProjectile(rec, target, now)
  local st = unitStats(rec.name, rec.ranged)
  if st.speed <= 0 or not target then return end
  SYN.nextHandle = SYN.nextHandle + 1
  SYN.pendN = SYN.pendN + 1
  SYN.pending[SYN.pendN] = {
    due = now + st.point, source = rec.idn, target = target.idn, speed = st.speed,
    handle = SYN.nextHandle, fullName = rec.name .. "_attack", pos = target,
    sourceName = rec.name, targetName = target.name,
  }
  -- observed attack target, used as Tower.GetAttackTarget fallback (L6)
  local at = SYN.attackTargets[rec.idx]
  if at then
    at.idn = target.idn; at.at = now
  else
    SYN.attackTargets[rec.idx] = { idn = target.idn, at = now }
  end
end
local function flushPending(s, now)
  if SYN.pendN == 0 then return end
  local pend, nils = SYN.pending, 0
  for i = 1, SYN.pendN do
    local e = pend[i]
    if e then
      if now >= e.due then
        pend[i] = nil; nils = nils + 1
        SYN.stats.projN = SYN.stats.projN + 1
        if not SYN.stats.projSample then
          SYN.stats.projSample = string.format("handle=%d source=%s target=%s moveSpeed=%.0f isAttack=true ability=nil",
            e.handle, tostring(e.source), tostring(e.target), e.speed)
        end
        evLogf("proj", 1.5, "[ev] OnProjectile handle=%d source=%s target=%s moveSpeed=%.0f isAttack=true ability=nil",
          e.handle, tostring(e.sourceName or e.source), tostring(e.targetName or e.target), e.speed)
        local pay = PAY.proj
        pay.source = e.source; pay.target = e.target; pay.ability = nil
        pay.moveSpeed = e.speed; pay.sourceAttachment = 0; pay.particleSystemHandle = 0
        pay.dodgeable = true; pay.isAttack = true
        pay.expireTime = now + 5.0; pay.maxImpactTime = now + 2.0
        pay.launch_tick = 0; pay.colorGemColor = 0
        pay.fullName = e.fullName; pay.name = "attack"; pay.handle = e.handle
        pay.target_loc = mathx.Vector(e.pos.x, e.pos.y, e.pos.z)
        pay.original_move_speed = e.speed
        fire(s, "OnProjectile", pay)
      end
    else
      nils = nils + 1
    end
  end
  if nils > 0 then
    local j = 0
    for i = 1, SYN.pendN do local e = pend[i]; if e then j = j + 1; pend[j] = e end end
    for i = j + 1, SYN.pendN do pend[i] = nil end
    SYN.pendN = j
  end
end
local function findTarget(rec, now)
  local st = unitStats(rec.name, rec.ranged)
  local reach = (oRange > 0 and rec.range or st.range) + 350
  if reach < 500 then reach = 500 end
  local reach2 = reach * reach
  local best, bestD = nil, reach2
  local yaw = math.rad(rec.yaw or 0)
  local fx, fy = math.cos(yaw), math.sin(yaw)
  local list, n = SYN.list, SYN.listN
  for i = 1, n do
    local o = list[i]
    if o ~= rec and o.life == 0 and o.team ~= rec.team and o.dormant ~= true then
      local dx, dy = o.x - rec.x, o.y - rec.y
      local d2 = dx * dx + dy * dy
      if d2 < bestD then
        -- prefer units in front (module rotation); close targets ignore facing
        if d2 < 100 * 100 or (dx * fx + dy * fy) > 0.2 * math.sqrt(d2) then
          best, bestD = o, d2
        end
      end
    end
  end
  return best
end

-- one scan of the client entity list ---------------------------------------
-- fires OnEntityHurt/OnNpcDying/OnEntityDestroy/OnUnitAnimation(End) and the
-- teleport-particle approximation; schedules attack projectiles.
local function scan(s, now)
  SYN.stamp = SYN.stamp + 1
  local st = SYN.stamp
  local map = SYN.ent
  local list, n = SYN.list, 0
  local hurts, hn = nil, 0
  local npcN = 0
  local lat = latency()
  local myTeam = nil
  local hero = localHero()
  if hero then myTeam = tonumber(ru8(ent.instance(hero), oTeam)) or nil end
  -- task-10: animation/projectile callbacks only matter near the local hero.
  -- last_hit.animation drops events past 2500 of ctx.position and
  -- positioning.animation past 350, so 2500 is the exact consumer bound —
  -- filtering here keeps the per-poll burst small without changing decisions.
  -- Disable with bisect `animfilter=0` for full parity.
  local hx, hy = 0, 0
  if hero then
    local hp = _G.Entity.GetAbsOrigin(hero)
    if hp then hx, hy = hp.x or 0, hp.y or 0 end
  end
  local filterR2 = 2500 * 2500
  local function nearHero(rec)
    if not BISECT.animfilter or not hero then return true end
    local dx, dy = rec.x - hx, rec.y - hy
    return dx * dx + dy * dy <= filterR2
  end
  for idn in ent.iter() do
    local nm = ent.designerName(idn)
    if nm and nm:find("npc_dota", 1, true) then
      local inst = ent.instance(idn)
      if inst and inst > 0x10000 and rdok(inst, 0x20) then
        local h = ri(idn, 0x10)
        if h then
          local idx = h % 0x8000
          local rec = map[idx]
          if not rec or rec.idn ~= idn then
            rec = { fresh = true }
            map[idx] = rec
          end
          rec.stamp = st
          rec.idn = idn
          rec.inst = inst
          rec.idx = idx
          rec.name = nm
          rec.npc = true
          rec.fresh = rec.fresh or false
          rec.hp = ri(inst, oHealth) or 0
          rec.maxhp = ri(inst, oMaxHealth) or 0
          rec.life = ru8(inst, oLife) or 0
          rec.team = ru8(inst, oTeam) or 0
          rec.act = ri(inst, oAct) or 0
          rec.seq = ri(inst, oSeqIdx) or 0
          rec.lat = rf(inst, oLastAtk) or 0
          rec.ldd = rf(inst, oLastDealt) or 0
          local caps = oAtkCaps > 0 and ri(inst, oAtkCaps) or 0
          rec.ranged = (math.floor(caps / 2) % 2) == 1  -- DOTA_UNIT_CAP_RANGED_ATTACK bit
          -- task-25: real visibility + first-seen time. Entity.IsDormant reads the
          -- instance byte at +0x30 ((v % 0x100) >= 0x80); replicate it here so
          -- the globals layer can classify visible vs out-of-vision groups.
          local df = ru8(inst, 0x30)
          rec.dormant = df ~= nil and df >= 0x80
          if rec.firstSeen == nil then rec.firstSeen = now end
          local node = rptr(inst, oNode)
          if node and node > 0x10000 and rdok(node + oSceneOrg, 12) then
            local fp = ffi.cast("float*", node + oSceneOrg)
            rec.x, rec.y, rec.z = tonumber(fp[0]) or 0, tonumber(fp[1]) or 0, tonumber(fp[2]) or 0
            if rdok(node + oSceneRot, 8) then
              rec.yaw = tonumber(ffi.cast("float*", node + oSceneRot + 4)[0]) or 0
            else
              rec.yaw = 0
            end
          else
            rec.x, rec.y, rec.z = 0, 0, 0
            rec.yaw = 0
          end
          if oRange > 0 then rec.range = ri(inst, oRange) or 0 else rec.range = 0 end
          n = n + 1; list[n] = rec
          npcN = npcN + 1
          if not rec.fresh then
            if rec.pHp ~= nil and rec.hp < rec.pHp and rec.pLife == 0 and rec.hp >= 0 then
              hurts = hurts or {}
              hn = hn + 1
              -- capture the delta NOW: rec.pHp is overwritten with the current
              -- value before the deferred hurt dispatch (was firing damage=0)
              hurts[hn] = { rec = rec, dmg = rec.pHp - rec.hp }
            end
            if rec.pLife == 0 and rec.life ~= 0 and not rec.dying then
              rec.dying = true
              fire(s, "OnNpcDying", idn)
            elseif rec.life == 0 and rec.pLife ~= nil and rec.pLife ~= 0 then
              rec.dying = false   -- respawn / reincarnation: arm the next death
            end
            local kind, pkind = actKind(rec.act), actKind(rec.pAct)
            local newSwing = (kind == "attack" and rec.lat ~= rec.pLat and rec.lat > 0)
            if (rec.act ~= rec.pAct or (rec.seq ~= rec.pSeq and kind) or newSwing) and nearHero(rec) then
              if kind then
                local castpoint = 0
                if kind == "attack" then castpoint = unitStats(nm, rec.ranged).point end
                -- The engine stamps m_flLastAttackTime when the swing starts, so
                -- compensate our poll delay exactly like a lag-compensation value:
                -- last_hit computes release = (now - lag_compensation_time) + castpoint.
                local detectLag = 0
                if kind == "attack" and rec.lat and rec.lat > 0 and rec.lat <= now + 0.05 then
                  detectLag = math.max(0, now - rec.lat)
                end
                local lagTotal = math.min(2.0, lat + detectLag)
                local st = SYN.stats
                st.animN = st.animN + 1
                st.animPoints["p" .. string.format("%.2f", castpoint)] = true
                if not st.animSample then
                  st.animSample = string.format("unit=%s activity=%d castpoint=%.3f lag=%.3f seq=%d",
                    nm, rec.act, castpoint, lagTotal, rec.seq)
                end
                evLogf("anim", 1.5, "[ev] OnUnitAnimation unit=%s activity=%d castpoint=%.3f lag=%.3f detect=%.3f type=0 sequenceName=%s",
                  nm, rec.act, castpoint, lagTotal, detectLag, kind == "attack" and "attack" or "cast")
                local pay = PAY.anim
                pay.unit = idn; pay.activity = rec.act; pay.type = 0
                pay.sequence = rec.seq; pay.sequenceVariant = 0; pay.playbackRate = 1.0
                pay.castpoint = castpoint
                pay.sequenceName = kind == "attack" and "attack" or "cast"
                pay.lag_compensation_time = lagTotal
                fire(s, "OnUnitAnimation", pay)
                if kind == "attack" then
                  local target = findTarget(rec, now)
                  -- release time = actual swing start + castpoint (not poll time)
                  local atkStart = (rec.lat and rec.lat > 0 and rec.lat <= now + 0.05) and rec.lat or now
                  if target then scheduleProjectile(rec, target, atkStart) end
                  -- task-25: attack record for LIB_DAMAGE_PREDICTION.unit_attack
                  -- (absolute game-time release; melee and ranged, near-hero only).
                  if target then
                    local due = atkStart + castpoint
                    if rec.ranged then
                      local dx, dy = (rec.x or 0) - (target.x or 0), (rec.y or 0) - (target.y or 0)
                      local dist = math.sqrt(dx * dx + dy * dy)
                      local spd = unitStats(nm, true).speed or 0
                      if spd and spd > 0 then due = due + dist / spd end
                    end
                    SYN.unitAttack = SYN.unitAttack or {}
                    SYN.unitAttack[rec.idx] = {
                      source = idn, target = target.idn, swingStart = atkStart, due = due,
                      castpoint = castpoint, kind = rec.ranged and 1 or 0,
                      is_tower = (nm:find("tower", 1, true) ~= nil), stamp = now,
                    }
                  end
                end
              elseif pkind then
                SYN.stats.animEndN = SYN.stats.animEndN + 1
                if not SYN.stats.animEndSample then
                  SYN.stats.animEndSample = "unit=" .. nm
                end
                evLogf("animend", 1.5, "[ev] OnUnitAnimationEnd unit=%s snap=false", nm)
                local pay = PAY.animEnd
                pay.unit = idn; pay.snap = false
                fire(s, "OnUnitAnimationEnd", pay)
              end
            end
            -- teleport particle approximation: ACT_DOTA_TELEPORT_END means the
            -- enemy just landed; teleports.create() only needs the unit + index
            -- and the point update carries the arrival position.
            if rec.act == ACT_TELEPORT_END and rec.pAct ~= ACT_TELEPORT_END
               and myTeam and rec.team ~= myTeam and nm:find("npc_dota_hero", 1, true) then
              rec.tpIndex = 0x400000 + idx
              fire(s, "OnParticleCreate", {
                index = rec.tpIndex, entity = idn, entity_id = idx,
                entityForModifiers = idn, entity_for_modifiers_id = idx,
                attachType = 1, fullName = "particles/items2_fx/teleport_end.vpcf",
                name = "teleport_end", hash = 0, particleNameIndex = 0,
              })
              fire(s, "OnParticleUpdate", {
                index = rec.tpIndex, controlPoint = 5,
                position = mathx.Vector(rec.x, rec.y, rec.z),
              })
            elseif rec.act ~= ACT_TELEPORT_END and rec.pAct == ACT_TELEPORT_END and rec.tpIndex then
              fire(s, "OnParticleDestroy", { index = rec.tpIndex, destroyImmediately = false })
              rec.tpIndex = nil
            end
          end
          rec.pHp, rec.pLife, rec.pAct, rec.pSeq =
            rec.hp, rec.life, rec.act, rec.seq
          rec.pLat = rec.lat
          rec.fresh = false
        end
      end
    end
  end
  SYN.listN = n
  -- source attribution + OnEntityHurt (runs after the scan so every attacker
  -- in this poll is known)
  if hurts then
    local budget = 80
    for i = 1, hn do
      if i > budget then
        SYN.stats.hurtsDropped = SYN.stats.hurtsDropped + (hn - budget); break
      end
      local entry = hurts[i]
      local rec = entry.rec
      local dmg = entry.dmg
      -- source attribution, strongest evidence first (task-11 wants >=90%):
      --  (a) an attacker whose observed attack target IS this entity (we saw
      --      its attack animation/projectile aim at it) — near-certain;
      --  (b) engine stamp m_flLastDealtDamageTime inside the last 1.2s;
      --  (c) fallback: enemy in attack animation with m_flLastAttackTime <1.5s
      --      and within its attack reach (covers missing/not-replicated stamps).
      -- Never fabricate: if nothing fits the payload gets source=nil and the
      -- [ev] summary reports the with_source percentage.
      local src, bestScore = nil, -1
      for j = 1, n do
        local a = list[j]
        if a ~= rec and a.life == 0 and a.team ~= rec.team then
          local dx, dy = a.x - rec.x, a.y - rec.y
          local d2 = dx * dx + dy * dy
          if d2 < 2200 * 2200 then
            local score
            local tgt = SYN.attackTargets[a.idx]
            if tgt and tgt.idn == rec.idn and (now - tgt.at) < 2.5 then
              score = 1000 - (now - tgt.at)
            elseif a.ldd and a.ldd > 1 and (now - a.ldd) > -0.25 and (now - a.ldd) < 1.2 then
              score = 100 + (a.ldd - now)
            elseif actKind(a.act) == "attack" and a.lat and (now - a.lat) < 1.5 then
              local reach = (a.range > 0 and a.range or 500) + 350
              if d2 < reach * reach then score = 10 + (a.lat - now) end
            end
            if score and score > bestScore then src, bestScore = a, score end
          end
        end
      end
      local st = SYN.stats
      st.hurtN = st.hurtN + 1
      if src then
        st.hurtWithSource = st.hurtWithSource + 1
        if not st.hurtSample then
          st.hurtSample = string.format("source=%s target=%s damage=%d ability=nil",
            src.name, rec.name, dmg)
        end
      end
      evLogf("hurt", 1.5, "[ev] OnEntityHurt source=%s target=%s damage=%d ability=nil",
        src and src.name or "nil", rec.name, dmg)
      local pay = PAY.hurt
      pay.source = src and src.idn or nil
      pay.target = rec.idn
      pay.ability = nil
      pay.damage = dmg
      fire(s, "OnEntityHurt", pay)
    end
  end
  -- removals -> OnEntityDestroy (npc only; the script cleans the rest by index)
  for idx, rec in pairs(map) do
    if rec.stamp ~= st then
      if rec.idn and not rec.destroyFired then
        rec.destroyFired = true
        fire(s, "OnEntityDestroy", rec.idn)
      end
      map[idx] = nil
    end
  end
  return npcN
end

-- human order detection: controller seq delta not produced by us -------------
local function pollOrders(s, now)
  local ctrl = localController()
  if not ctrl then return end
  local seq = ri(ctrl, 0x9B8)
  if not seq then return end
  if SYN.seqLast == nil then
    SYN.seqLast = seq
    return
  end
  if seq == SYN.seqLast then return end
  local delta = seq - SYN.seqLast
  if delta < 0 or delta > 64 then
    -- sequence reset (new match / reconnect): rebaseline, never fire
    SYN.seqLast = seq
    SYN.ownSeq = {}; SYN.ownSeqN = 0
    return
  end
  local human = 0
  for sq = SYN.seqLast + 1, seq do
    if not SYN.ownSeq[sq] then human = human + 1 end
  end
  SYN.seqLast = seq
  -- prune old bookkeeping
  local cut = seq - 512
  for sq in pairs(SYN.ownSeq) do if sq < cut then SYN.ownSeq[sq] = nil end end
  if human <= 0 then return end
  local hero = localHero()
  local player = localPlayer()
  if not hero or not player then
    -- cannot build the payload identity the script compares against; skip
    if SYN._noPlayerLogged ~= true then
      SYN._noPlayerLogged = true
      log("events: human order seen but no local hero/player identity; OnPrepareUnitOrders skipped")
    end
    return
  end
  SYN.humanOrders = SYN.humanOrders + 1
  local prevArm = SYN.pauseArmed
  if prevArm and now < SYN.pauseUntil then
    log(string.format("[pause] RE-ARMED before expiry at seq %d->%d human=%d (prev until %.1f)",
      seq - delta, seq, human, SYN.pauseUntil))
  end
  -- cfg.manualPause in Self Play.lua is 4s; we cannot hook the script's own
  -- resume, so we log the window so QA can prove arm-once + expiry.
  SYN.pauseArmed, SYN.pauseUntil = now, now + 4.0
  log(string.format("[pause] human order armed: seq %d->%d human=%d npc=%s identifier=nil resume_at=%.1f",
    seq - delta, seq, human, (hero and ent.designerName(hero)) or "nil", SYN.pauseUntil))
  -- suspicious-frequency watchdog: if this keeps firing, some code path issues
  -- orders without going through orders.prepare (then our ownSeq bookkeeping is
  -- incomplete and the bot would pause itself). Emit evidence, not silence.
  local at = rawget(SYN, "armTimes")
  if not at then at = {}; SYN.armTimes = at end
  at[#at + 1] = now
  while at[1] and now - at[1] > 30 do table.remove(at, 1) end
  if #at >= 3 and ((not SYN._armWarn) or (now - SYN._armWarn > 30)) then
    SYN._armWarn = now
    log(string.format("[pause] WARNING %d human-order events within 30s (unrecorded bot orders?); last seq=%d",
      #at, seq))
  end
  fire(s, "OnPrepareUnitOrders", {
    player = player, order = 0, target = nil,
    position = mathx.Vector(0, 0, 0), ability = nil,
    orderIssuer = enums.PlayerOrderIssuer and enums.PlayerOrderIssuer.DOTA_ORDER_ISSUER_SELECTED_UNITS or 0,
    npc = hero, queue = false, showEffects = false, identifier = nil,
  })
end

-- game state / game end ------------------------------------------------------
local function pollGameState(s)
  local gs
  local ok, v = pcall(_G.GameRules.GetGameState)
  if ok then gs = tonumber(v) end
  if gs == nil then return false end
  if SYN.gameState ~= nil and gs ~= SYN.gameState then
    if SYN.matchSeen and SYN.gameState == 5 and gs ~= 5 then
      SYN.matchSeen = false
      fire(s, "OnGameEnd")
      -- drop match-local event state so the next match starts clean
      SYN.ent = {}
      SYN.pending = {}; SYN.pendN = 0
      SYN.attackTargets = {}
      SYN.seqLast = nil; SYN.ownSeq = {}; SYN.ownSeqN = 0
      SYN.pauseArmed = nil; SYN.armTimes = nil
      SYN.heroAt, SYN.playerAt, SYN.ctrlAt = -999, -999, -999
      log("events: match ended, synthesizer state reset")
    end
  end
  SYN.gameState = gs
  if gs == 5 then SYN.matchSeen = true end
  return gs == 4 or gs == 5
end

-- public API ---------------------------------------------------------------
local M = {}

function M.load()
  local tLoad = os.clock()
  bisectLoad(true)
  log("loader: loading Self Play ...")
  local t0 = os.clock()
  local ok, script = pcall(require, "Self Play")
  local loadMs = (os.clock() - t0) * 1000
  if not ok then log("loader: LOAD ERROR:", script); return nil, script end
  log(string.format("loader: Self Play loaded in %.0fms, callbacks:%s", loadMs, type(script)))
  M.script = script
  -- preload game KVs outside of match time (one-time parse cost)
  local tKV = os.clock()
  pcall(kvLoad)
  local kvMs = (os.clock() - tKV) * 1000
  local tSL = os.clock()
  if type(script) == "table" and script.OnScriptsLoaded then
    local ok2, err = pcall(script.OnScriptsLoaded)
    if not ok2 then log("loader: OnScriptsLoaded error:", err) end
  end
  local slMs = (os.clock() - tSL) * 1000
  -- ---- load-time warmup (task-10): everything heavy must happen HERE, not in
  -- the first match tick. Warm the entity/designer cache, the nav obstacle
  -- grid, the heavy script data modules and one script update pass (Umbrella
  -- calls OnUpdateEx in the menu too, so this is a supported path).
  local tWarm = os.clock()
  local warmEntityMs, warmNavMs, warmRequireMs, warmUpdateMs = 0, 0, 0, 0
  if not BISECT.warmup then
    log("[bisect] warmup disabled (warmup=0)")
  else
  do
    local e0 = os.clock()
    local okE, errE = pcall(function()
      -- `ent` is the required module (loader.lua:198); there is no global
      -- `entity` in this state (previous code indexed the global and always
      -- failed silently -> warmup entity/designer scan was skipped).
      local em = ent or require("entity")
      em.init()
      for idn in em.iter() do em.designerName(idn) end
    end)
    warmEntityMs = (os.clock() - e0) * 1000
    if not okE then
      logOnce("warmup.entity", "loader: warmup entity scan error: " .. tostring(errE), 50)
    end
  end
  if navmod and navmod.refresh then
    local n0 = os.clock()
    local okN, errN = pcall(navmod.refresh)
    warmNavMs = (os.clock() - n0) * 1000
    if not okN then log("loader: warmup nav.refresh error:", errN) end
  end
  do
    local r0 = os.clock()
    for _, mod in ipairs({ "self_play.catalog", "self_play.draft_data", "self_play.translations",
                           "self_play.localization", "self_play.build_brain", "self_play.heroes.registry" }) do
      pcall(require, mod)
    end
    warmRequireMs = (os.clock() - r0) * 1000
  end
  if type(script) == "table" and script.OnUpdateEx then
    local u0 = os.clock()
    local okU, errU = pcall(script.OnUpdateEx)
    warmUpdateMs = (os.clock() - u0) * 1000
    if not okU then log("loader: warmup OnUpdateEx error:", errU) end
  end
  end -- /warmup enabled
  local warmMs = (os.clock() - tWarm) * 1000
  if not logOffsetsDone then
    logOffsetsDone = true
    log(string.format("events: offsets hp=0x%X life=0x%X team=0x%X node=0x%X origin=0x%X act=0x%X seq=0x%X lastatk=0x%X lastdealt=0x%X range=0x%X mbi=%s",
      oHealth, oLife, oTeam, oNode, oSceneOrg, oAct, oSeqIdx, oLastAtk, oLastDealt, oRange, mbiTypeName))
  end
  log(string.format("[perf] load total=%.0fms require=%.0fms kv=%.0fms onLoaded=%.0fms warmup=%.0fms (entity=%.0fms nav=%.0fms modules=%.0fms updateEx=%.0fms)",
    (os.clock() - tLoad) * 1000, loadMs, kvMs, slMs, warmMs, warmEntityMs, warmNavMs, warmRequireMs, warmUpdateMs))
  M._loaded = true
  return script
end

-- wrap orders.prepare so every order WE issue is recorded; the controller
-- outgoing-seq delta then tells human orders apart from bot orders.
M.ownSeq = SYN.ownSeq
do
  local ordmod = require("orders")
  local orig = ordmod.prepare
  if rawget(ordmod, "_evWrapped") == nil then
    rawset(ordmod, "_evWrapped", true)
    ordmod.prepare = function(...)
      local before = ordmod.lastSeq
      local r = orig(...)
      local after = ordmod.lastSeq
      if after and after ~= before then
        local from = (before or (after - 1)) + 1
        if from < after - 8 then from = after - 8 end
        for sq = from, after do SYN.ownSeq[sq] = true end
        SYN.ownSeqN = SYN.ownSeqN + 1
      end
      return r
    end
  end
end

-- poll(mode): "tick" does the full scan; "draw" flushes due projectiles and
-- (when the scan measured cheap) does a full scan too for sub-tick latency.
-- task-25: Umbrella globals layer (bound at the bottom of this file).
local globals

function M.poll(mode)
  local s = M.script
  if not s then return end
  bisectLoad()
  if not BISECT.events or not BISECT.poll then return end
  local t0 = os.clock()
  local now = gameTime()
  local inGame = pollGameState(s)
  pollOrders(s, now)
  -- [pause] watchdog: arm-once + expiry proof for QA; a pause must never be
  -- re-armed without a NEW human order (each arm logs its seq range above).
  if SYN.pauseArmed and now > SYN.pauseUntil then
    log(string.format("[pause] pause window expired (armed_at=%.1f now=%.1f) -> bot resumes", SYN.pauseArmed, now))
    SYN.pauseArmed = nil
  end
  if inGame and BISECT.synth then
    local doScan = true
    if mode == "draw" then
      if not BISECT.drawscan then
        doScan = false; SYN.stats.drawSkips = SYN.stats.drawSkips + 1
      elseif SYN.drawSkip then
        doScan = false; SYN.stats.drawSkips = SYN.stats.drawSkips + 1
      end
    end
    if doScan then
      local ok, err = pcall(scan, s, now)
      if not ok then
        SYN.stats.errors = SYN.stats.errors + 1
        if SYN._errLogged < 6 then SYN._errLogged = SYN._errLogged + 1; log("events: scan error: " .. tostring(err)) end
      end
    end
    flushPending(s, now)
    -- task-25: refresh the globals layer from the SAME cached scan (one pass
    -- per tick; no extra entity walk, no per-call cost for the scripts).
    if globals and doScan then
      local okG, errG = pcall(globals.update, SYN, now)
      if not okG and not M._globalsErrLogged then
        M._globalsErrLogged = true
        log("globals: update error: " .. tostring(errG))
      end
    end
  end
  local cost = os.clock() - t0
  local st = SYN.stats
  st.polls = st.polls + 1
  st.cost = st.cost + cost
  if cost > st.maxCost then st.maxCost = cost end
  -- [perf] profiling (task-10): split our scan/bookkeeping from the cost of the
  -- script's own callback handlers, and name the slow-poll culprit.
  local fireCost = 0
  for _, v in pairs(st.pollFire) do fireCost = fireCost + v end
  local scanCost = cost - fireCost
  st.scanCost = (st.scanCost or 0) + scanCost
  if cost > 0.2 then
    st.slowPolls = st.slowPolls + 1
    local topName, topV = "none", 0
    for name, v in pairs(st.pollFire) do if v > topV then topName, topV = name, v end end
    log(string.format("[perf] slow poll mode=%s cost=%.1fms scan=%.1fms fire=%.1fms top=%s(%.1fms) polls=%d",
      mode, cost * 1000, scanCost * 1000, fireCost * 1000, topName, topV * 1000, st.polls))
  end
  st.pollFire = {}
  -- adaptive: keep per-redraw polling only while the *scan* is cheap
  if mode == "tick" then
    st.ticks = (st.ticks or 0) + 1
    if st.ticks % 5 == 0 then
      SYN.drawSkip = (st.scanCost / math.max(1, st.polls)) > 0.012
    end
  end
  if SYN.verbose or (mode == "tick" and os.clock() - st.lastReport > 30) then
    st.lastReport = os.clock()
    local parts = {}
    for name, n in pairs(st.fires) do parts[#parts + 1] = name .. "=" .. n end
    table.sort(parts)
    local slow = {}
    for name, v in pairs(st.fireByName) do
      if v > 0.05 then slow[#slow + 1] = string.format("%s=%.0fms", name, v * 1000) end
    end
    table.sort(slow)
    log(string.format("events: polls=%d avg=%.1fms scan=%.1fms fire=%.1fms max=%.1fms slowPolls=%d errors=%d hurtsDropped=%d humanOrders=%d drawSkips=%d %s | %s",
      st.polls, st.cost / st.polls * 1000, (st.scanCost or 0) / st.polls * 1000,
      (st.fireCost or 0) / st.polls * 1000, st.maxCost * 1000, st.slowPolls or 0, st.errors,
      st.hurtsDropped, SYN.humanOrders, st.drawSkips, table.concat(parts, " "), table.concat(slow, " ")))
    -- [ev] payload contract summaries (task-11): values, not just counts
    if st.animN > 0 then
      local pts = {}
      for k in pairs(st.animPoints) do pts[#pts + 1] = k end
      table.sort(pts)
      log(string.format("[ev] OnUnitAnimation summary n=%d distinct_castpoint=%d values={%s} sample{%s}",
        st.animN, #pts, table.concat(pts, ","), tostring(st.animSample)))
    end
    if st.animEndN > 0 then
      log(string.format("[ev] OnUnitAnimationEnd summary n=%d sample{%s}", st.animEndN, tostring(st.animEndSample)))
    end
    if st.hurtN > 0 then
      log(string.format("[ev] OnEntityHurt summary n=%d with_source=%d (%.0f%%) sample{%s}",
        st.hurtN, st.hurtWithSource, 100 * st.hurtWithSource / st.hurtN, tostring(st.hurtSample)))
    end
    if st.projN > 0 then
      log(string.format("[ev] OnProjectile summary n=%d sample{%s}", st.projN, tostring(st.projSample)))
    end
  end
end

function M.tick()
  local s = M.script; if not s then return end
  -- api.lua per-tick scan guard (api-core): bumped once before any script callback
  _G.HAKE_TICK = (_G.HAKE_TICK or 0) + 1
  local t0 = os.clock()
  -- phase breadcrumbs: if a tick hangs, the LAST phase line names the offender.
  local verbosePhases = (SYN.tickN or 0) < 3 or (SYN.lastTotal or 0) > 5000
  local function phase(name)
    if verbosePhases then
      log(string.format("[perf] phase %s t=%.0fms", name, (os.clock() - t0) * 1000))
    end
  end
  SYN.phaseLog = verbosePhases
  phase("tick_start")
  bisectLoad()
  local tm = { nav = 0, synth = 0, pump = 0, script = 0, draw = 0, overlay = 0 }
  local a
  if navmod and BISECT.nav then
    phase("nav_start")
    a = os.clock()
    local hx, hy
    local h = localHero()
    if h then
      local p = _G.Entity.GetAbsOrigin(h)
      if p then hx, hy = p.x, p.y end
    end
    pcall(navmod.refresh, hx, hy)
    tm.nav = (os.clock() - a) * 1000
    phase("nav_done")
  end
  a = os.clock()
  phase("poll_start")
  local okS, errS = pcall(M.poll, "tick")
  tm.synth = (os.clock() - a) * 1000
  phase("poll_done")
  if not okS and SYN._errLogged < 6 then SYN._errLogged = SYN._errLogged + 1; log("poll error:", errS) end
  a = os.clock()
  phase("pump_start")
  local okP, errP = pcall(function() require("overlay").pump() end)
  tm.pump = (os.clock() - a) * 1000
  phase("pump_done")
  if not okP and not M._pumpErr then M._pumpErr = true; log("pump error:", errP) end
  a = os.clock()
  render.beginFrame()
  tm.overlay = (os.clock() - a) * 1000
  -- L11: rate-limit repeated script errors (the old code logged every tick)
  a = os.clock()
  phase("script_start")
  local scriptExMs, scriptUpdMs = 0, 0
  if BISECT.update then
    if s.OnUpdateEx then
      phase("updateEx_start")
      local b0 = os.clock()
      local ok, err = pcall(s.OnUpdateEx)
      scriptExMs = os.clock() - b0
      phase("updateEx_done")
      if not ok then logOnce("OnUpdateEx.err", "OnUpdateEx error: " .. tostring(err), 200) end
    end
    if s.OnUpdate then
      phase("update_start")
      local b0 = os.clock()
      local ok, err = pcall(s.OnUpdate)
      scriptUpdMs = os.clock() - b0
      phase("update_done")
      if not ok then logOnce("OnUpdate.err", "OnUpdate error: " .. tostring(err), 200) end
    end
  end
  tm.script = (os.clock() - a) * 1000
  phase("script_done")
  a = os.clock()
  if BISECT.draw and s.OnDraw then
    local ok, err = pcall(s.OnDraw)
    if not ok then logOnce("OnDraw.err", "OnDraw error: " .. tostring(err), 200) end
  end
  tm.draw = (os.clock() - a) * 1000
  a = os.clock()
  if BISECT.draw then
    local okO, errO = pcall(function()
      local overlay = require("overlay")
      local okP, n = overlay.present(render.frame)
      if not M._overlayLogged then
        M._overlayLogged = true
        log("overlay", tostring(okP), tostring(n), "cmds", #render.frame)
      end
    end)
    if not okO and not M._overlayErr then M._overlayErr = true; log("overlay error:", errO) end
  end
  tm.overlay = tm.overlay + (os.clock() - a) * 1000
  -- [perf] task-10: one compact line per tick so QA can compute p50/p90/p99/max;
  -- the FIRST tick is flagged separately (must be <2s after load-time warmup).
  -- In-match detail every 10th tick; in the lobby/menu every 50th (log noise).
  local total = (os.clock() - t0) * 1000
  SYN.tickN = (SYN.tickN or 0) + 1
  SYN.tickCost = (SYN.tickCost or 0) + total / 1000
  if SYN.tickN == 1 then
    log(string.format("[perf] first-tick total=%.0fms nav=%.0f synth=%.0f pump=%.0f script=%.0f (onUpdateEx=%.0f onUpdate=%.0f) draw=%.0f overlay=%.0f loaded=%s",
      total, tm.nav, tm.synth, tm.pump, tm.script, scriptExMs * 1000, scriptUpdMs * 1000,
      tm.draw, tm.overlay, tostring(M._loaded == true)))
  elseif total > 1000
         or (SYN.matchSeen and SYN.tickN % 10 == 0)
         or (not SYN.matchSeen and SYN.tickN % 50 == 0) then
    log(string.format("[perf] tick n=%d total=%.0fms nav=%.0f synth=%.0f pump=%.0f script=%.0f (onUpdateEx=%.0f onUpdate=%.0f) draw=%.0f overlay=%.0f avg=%.0fms%s",
      SYN.tickN, total, tm.nav, tm.synth, tm.pump, tm.script, scriptExMs * 1000, scriptUpdMs * 1000,
      tm.draw, tm.overlay, SYN.tickCost / SYN.tickN * 1000, total > 1000 and " SLOW" or ""))
  end
end

-- cheap draw-only pass: called between bot ticks so the HUD / world markers
-- refresh per frame like the original (OnDraw in Umbrella runs every frame).
-- It also pumps pending synthesizer events (projectile flush / redraw scan).
function M.drawOnly()
  local s = M.script; if not s then return false end
  pcall(M.poll, "draw")
  render.beginFrame()
  if s.OnDraw then
    local ok = pcall(s.OnDraw)
    if ok then
      pcall(function() require("overlay").present(render.frame) end)
      return true
    end
  end
  return false
end

