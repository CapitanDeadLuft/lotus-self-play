-- BISECT SWITCHES (Lead-approved fallback, no source edit needed for QA).
-- Optional file D:\hake\lotus\bisect.txt is re-read at load and at most once
-- per second while ticks run, so QA can flip it between (or even during) runs:
--   events=0      skip the whole event synthesizer poll (all callbacks)
--   synth=0       skip only the entity scan (keeps game-state/order polling)
--   nav=0         skip nav.refresh() in the tick
--   clock=0       set _G.HAKE_CLOCK_ESTIMATE=0 (api.lua clock fast-path switch)
--   entitycache=0 set _G.HAKE_ENTITY_CACHE=0 (entity cache fast-path switch)
--   warmup=0      skip load-time warmup scans/preloads
--   update=0      skip Self Play OnUpdateEx/OnUpdate calls
--   draw=0        skip OnDraw + overlay present
--   poll=0        alias of events=0
--   drawscan=1    re-enable the per-redraw entity scan (default OFF)
--   animfilter=0  disable the 2500-unit radius filter for animation/projectile
--                 events (2500 = the last_hit.animation consumer bound)
--                 events (default ON)
-- Absent file or token=1 means ENABLED (drawscan is the exception: default 0).
-- Each change logs one line:
--   [bisect] active animfilter=1 clock=1 draw=1 drawscan=0 entitycache=1 ...
-- ===========================================================================
local BISECT = { events = true, synth = true, nav = true, clock = true,
                 entitycache = true, warmup = true, update = true, draw = true, poll = true,
                 -- perf knobs (task-10): redraw-mode entity scan is OFF by default
                 -- (tick cadence is <1s now); animation/projectile events are
                 -- filtered to units within 2500 of the local hero (exact
                 -- last_hit.animation bound: it bails past 2500).
                 drawscan = false, animfilter = true }
local BISECT_PATH = "D:\\hake\\lotus\\bisect.txt"
local bisectAt, bisectSig = -999, nil
local function bisectApply()
  _G.HAKE_CLOCK_ESTIMATE = BISECT.clock and 1 or 0
  _G.HAKE_ENTITY_CACHE = BISECT.entitycache and 1 or 0
end
local function bisectLoad(force)
  local t = os.clock()
  if not force and t - bisectAt < 0.9 then return end
  bisectAt = t
  local f = io.open(BISECT_PATH, "r")
  if not f then
    bisectApply()
    return
  end
  local txt = f:read("*a") or ""
  f:close()
  for k, v in txt:gmatch("([%a_]+)%s*=%s*(%d)") do
    local key = k:lower()
    if BISECT[key] ~= nil then BISECT[key] = tonumber(v) ~= 0 end
  end
  bisectApply()
  local keys = {}
  for k in pairs(BISECT) do keys[#keys + 1] = k end
  table.sort(keys)
  local sig, parts = "", {}
  for _, k in ipairs(keys) do
    sig = sig .. (BISECT[k] and "1" or "0")
    parts[#parts + 1] = k .. "=" .. (BISECT[k] and "1" or "0")
  end
  if sig ~= bisectSig then
    bisectSig = sig
    log("[bisect] active " .. table.concat(parts, " "))
  end
end

