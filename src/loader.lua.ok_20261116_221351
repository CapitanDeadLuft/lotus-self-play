    if sample then
      local ok, v = pcall(tw.GetAttackTarget, sample)
      out[#out + 1] = string.format("Tower.GetAttackTarget(%s)=%s (%s)", ent.designerName(sample),
        tostring(v ~= nil), ok and "ok" or "ERR")
