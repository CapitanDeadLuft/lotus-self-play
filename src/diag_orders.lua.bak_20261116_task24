  for _, cand in ipairs({ "magic_stick", "tango", "ward_observer", "branches", "clarity" }) do
    if ids[cand] and not orders.inventoryHas(cand) then buyName = cand; break end
  end
  local shop, shopSrc = inShopRange()
  if not buyName then
    log("purchase probe: every candidate item already owned — skip")
  elseif gold() >= 0 and gold() < 200 then
    log("purchase probe: gold too low (" .. tostring(gold()) .. ") — skip")
  elseif shop == false then
    -- not in a shop radius: a failed purchase here is expected, not a bug
    log("purchase probe: hero not in shop range (api=" .. tostring(shop) .. ") — skip (buy proof is in the bot_loop window)")
  else
