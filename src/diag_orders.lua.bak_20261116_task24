    check("nav path " .. i .. " waypoints walkable", badWp == 0, "bad=" .. badWp)
  end
  -- tree-walking branch (Treant): ignoreTrees=true ignores trees, never buildings
  local tp = os.clock()
  local pathT = nav.buildPath(hx, hy, 0, 0, true)
  local msT = (os.clock() - tp) * 1000
