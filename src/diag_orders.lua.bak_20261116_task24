        if beh and (bit.band(beh, 4) ~= 0) and (manacost or 0) > 0 then ability = a; break end
      end
    end
    if not ability then
      log("cast encoding probe: no no-target ability with mana cost on this hero — skip")
    else
      local aname = G.Ability.GetName(ability)
      local mana0 = G.NPC.GetMana(hero)
      local function castWith(mode)
        orders.setAbilityEncoding(mode)
        local manaB = G.NPC.GetMana(hero)
        local okC, spec = orders.castNoTarget(ability, { identifier = "diag_cast_" .. mode })
        sleep(350)
        local manaA = G.NPC.GetMana(hero)
        local cd = 0
        pcall(function() cd = G.Ability.GetCooldown(ability) or 0 end)
        log(string.format("cast probe mode=%s ability=%s ok=%s mana %.0f->%.0f cd=%.2f engine=%s",
          mode, aname, tostring(okC), manaB, manaA, cd or 0,
          spec and spec.engine and string.format("abil=%s", tostring(spec.engine.ability)) or "none"))
        pcall(orders.stop, { identifier = "diag_cast_stop" })
        sleep(150)
        return (manaB - manaA) > 1 or (cd or 0) > 0
