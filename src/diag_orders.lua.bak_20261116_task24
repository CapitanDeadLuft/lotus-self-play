          end
        end
      end
    end
    target = bestD
  end
  if target then
    local idx = G.Entity.GetIndex(target.idn)
    local okA, spec = orders.attackTarget(target.idn, { identifier = "diag_attack" })
    log(string.format("attack probe target=%s idx=%d d=%.0f ok=%s engine=%s", target.dn,
