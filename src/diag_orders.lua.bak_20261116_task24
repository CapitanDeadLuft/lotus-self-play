local pass, fail = 0, 0
local fails = {}
for _, r in ipairs(results) do
  if r.ok then pass = pass + 1 else fail = fail + 1; fails[#fails + 1] = r.name end
end
log(string.format("SUMMARY pass=%d fail=%d%s", pass, fail,
  fail > 0 and (" failed=[" .. table.concat(fails, "; ") .. "]") or ""))
log(string.format("orders stats: %s purchases: %s", orders.statsLine(),
  (function() local s = orders.purchaseStats(); return string.format("items=%d repeats=%d [%s]", s.items, s.repeats, s.detail) end)()))
log("=== DONE ===")
