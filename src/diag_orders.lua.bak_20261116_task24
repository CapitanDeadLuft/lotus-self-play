-- helper: issue a move order like the script does (NPC.MoveTo semantics)
local function moveOrder(x, y, identifier)
  local z = nav and nav.groundZ and nav.groundZ(x, y) or 128
  if G.NPC and G.NPC.MoveTo then
    local ok = pcall(G.NPC.MoveTo, G.Heroes.GetLocal(), G.Vector(x, y, z), false, false, false, true, identifier, false)
    return ok ~= false
  end
  return orders.moveTo(x, y, z, { identifier = identifier })
end

-- 4. movement continuity ---------------------------------------------------
local function pickGoal(minD, maxD)
  local best
  for i = 0, 15 do
    local a = i * math.pi / 8
    for _, r in ipairs({ 1600, 1200, 2200 }) do
      local x, y = hx + math.cos(a) * r, hy + math.sin(a) * r
      if nav and nav.isTraversable(x, y) then
        local p = nav.buildPath(hx, hy, x, y, false)
        if #p > 0 then
          local len = 0
          local px, py = hx, hy
          for _, w in ipairs(p) do len = len + dist2(px, py, w.x, w.y); px, py = w.x, w.y end
          if not best or math.abs(len - 1600) < math.abs(best.len - 1600) then
            best = { x = x, y = y, len = len, path = p }
          end
        end
      end
    end
  end
  return best
end

if nav then
  local goal = pickGoal()
  if not goal then
    log("movement probe: no reachable goal — skip")
  else
    log(string.format("movement probe goal=%s pathLen=%.0f waypoints=%d",
      fmtPos(goal.x, goal.y), goal.len, #goal.path))
    local x0, y0 = heroPos()
    local samples, stalls, maxStill, treeHits = {}, 0, 0, 0
    local prevX, prevY = x0, y0
    local stillSince = nil
    for step = 1, 60 do
      -- follow the planned path like helpers.farOrder: aim at the furthest
      -- waypoint within 1100 units, refresh target every ~0.2s
      local target = goal
      local px, py = prevX, prevY
      local acc = 0
      for _, w in ipairs(goal.path) do
        acc = acc + dist2(px, py, w.x, w.y)
        px, py = w.x, w.y
        if acc > 400 then target = w; break end
      end
      moveOrder(target.x, target.y, "diag_move")
      sleep(120)
      local x, y = heroPos()
      if x then
        local moved = dist2(prevX, prevY, x, y)
        samples[#samples + 1] = moved
        if nav.isTraversable and not nav.isTraversable(x, y) then treeHits = treeHits + 1 end
        if moved < 6 then
          stalls = stalls + 1
          stillSince = stillSince or os.clock()
        else
          stillSince = nil
        end
        prevX, prevY = x, y
      end
    end
    local total = dist2(x0, y0, prevX, prevY)
    local sum = 0
    local mx = 0
    for _, m in ipairs(samples) do sum = sum + m; if m > mx then mx = m end end
    log(string.format("movement result: start=%s end=%s travelled=%.0f avgStep=%.1f maxStep=%.1f stalls=%d treeHits=%d",
      fmtPos(x0, y0), fmtPos(prevX, prevY), total, #samples > 0 and (sum / #samples) or 0, mx, stalls, treeHits))
    check("movement: hero displaced > 400u", total > 400, string.format("%.0f", total))
    check("movement: no long stall (<= 12 of 60 samples still)", stalls <= 12, "stalls=" .. stalls)
    check("movement: no tree-cell entry", treeHits == 0, "treeHits=" .. treeHits)
    -- stop before the next phase so the hero does not keep walking
    pcall(orders.stop, { identifier = "diag_stop" })
    sleep(100)
  end
end

-- 5. goal inside an obstacle ----------------------------------------------
if nav and nav.dumpObstacles and entity then
  local obs = nav.dumpObstacles(20000)
  local trees = {}
  for _, o in ipairs(obs) do if o.kind == "tree" then trees[#trees + 1] = o end end
  local hx2, hy2 = heroPos()
  local best
  if hx2 then
    for i = 1, #trees, math.max(1, math.floor(#trees / 400)) do
      local t = trees[i]
      local d = dist2(hx2, hy2, t.x, t.y)
      if d > 300 and d < 1400 and (not best or d < best.d) then best = { t = t, d = d } end
    end
  end
  if not best then
    log("obstacle probe: no tree within 300..1400u (" .. #trees .. " trees known) — skip")
    check("obstacle: tree data accumulated", #trees > 20, "trees=" .. #trees)
  else
    local t = best.t
    local path = nav.buildPath(hx2, hy2, t.x, t.y, false)
    local last = path[#path]
    local snapped = last ~= nil and dist2(last.x, last.y, t.x, t.y) > 5
    log(string.format("obstacle probe tree=%s d=%.0f waypoints=%d last=%s snapped=%s",
      fmtPos(t.x, t.y), best.d, #path, last and fmtPos(last.x, last.y) or "none", tostring(snapped)))
    check("obstacle: goal inside tree yields path", #path > 0, "waypoints=" .. #path)
    if last then
      check("obstacle: endpoint snapped out of tree", nav.isTraversable(last.x, last.y),
        fmtPos(last.x, last.y))
      local x0, y0 = heroPos()
      moveOrder(last.x, last.y, "diag_obstacle")
      local tm, movedMax = 0, 0
      local px0, py0 = x0, y0
      for step = 1, 30 do
        sleep(150); tm = tm + 0.15
        local x, y = heroPos()
        if x then
          local d = dist2(px0, py0, x, y)
          if d > movedMax then movedMax = d end
          px0, py0 = x, y
          if dist2(x, y, last.x, last.y) < 120 then break end
        end
        if step == 8 and movedMax < 30 then moveOrder(last.x, last.y, "diag_obstacle_retry") end
      end
      local xE, yE = heroPos()
      log(string.format("obstacle result: end=%s target=%s remaining=%.0f",
        fmtPos(xE, yE), fmtPos(last.x, last.y), dist2(xE or 0, yE or 0, last.x, last.y)))
      check("obstacle: hero moved toward snapped goal", movedMax > 40, string.format("%.0f", movedMax))
      check("obstacle: hero not stuck in tree cell", nav.isTraversable(xE or 0, yE or 0) == true)
      pcall(orders.stop, { identifier = "diag_stop2" })
    end
  end
end

-- 6. attack order record ---------------------------------------------------
do
  local hx3, hy3 = heroPos()
  local target
  local team
  local okT, t = pcall(function()
    local hero = G.Heroes.GetLocal()
    return hero and G.Entity.GetTeamNum(hero)
  end)
  if okT then team = t end
  if entity and hx3 and team then
