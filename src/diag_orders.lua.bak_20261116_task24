    if spec and spec.engine then
      check("attack: engine recorded type=4", spec.engine.type == 4, tostring(spec.engine.type))
      check("attack: engine recorded target idx", spec.engine.target == idx,
        string.format("%s vs %d", tostring(spec.engine.target), idx))
    end
    pcall(orders.stop, { identifier = "diag_stop3" })
  else
    log("attack probe: no enemy creep within 900u — skip")
  end
