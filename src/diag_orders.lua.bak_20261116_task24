local function gf32(p, o) return tonumber(ffi.cast("float*", p + o)[0]) end
local function gi32(p, o) return tonumber(ffi.cast("int32_t*", p + o)[0]) end
local function rq(p, o) return tonumber(ffi.cast("uintptr_t*", p + o)[0]) end
local G = _G

local function heroPos()
  local inst = orders.localHero()
  if not inst then return nil end
  local x, y, z = orders.heroPosition(inst)
  if not x then return nil end
  return x, y, z, inst
end
local function gold()
  local ok, v = pcall(function() return G.Player.GetTotalGold(G.Players.GetLocal()) end)
  if ok and type(v) == "number" then return v end
  return -1
end
local function dist2(ax, ay, bx, by)
  local dx, dy = bx - ax, by - ay
  return math.sqrt(dx * dx + dy * dy)
end
local function heroAlive()
  local hero = G.Heroes and G.Heroes.GetLocal()
  if not hero then return false end
  local ok, v = pcall(G.Entity.IsAlive, hero)
  return (not ok) or v ~= false
end
local function waitAlive(maxSec)
  local t = 0
  while t < (maxSec or 30) do
    if heroAlive() and heroPos() then return true end
    sleep(500); t = t + 0.5
  end
  return false
end
local function inShopRange()
  local hero = G.Heroes and G.Heroes.GetLocal()
  if not hero then return false end
  local ok, v = pcall(G.NPC.IsInRangeOfShop, hero)
  if ok and v ~= nil then return v == true, "api" end
  return nil, "unknown"
end
