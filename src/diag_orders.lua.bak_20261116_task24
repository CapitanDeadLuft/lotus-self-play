-- diag_orders.lua — live in-process diagnostic for the order pipeline + GridNav.
--
-- Runs via the host watchdog (QA: in-process restart with call_elevated.bat;
-- never touch run.txt/stop.txt from a specialist). It issues REAL orders, so
-- run it in the single-player bot game with the bot loop STOPPED (exactly one
-- script at a time). Everything is logged to D:\hake\lotus\host.log with the
-- tag [DIAG-ORD] so QA can grep it.
--
-- Phases
--   0 env        hero/team/gold/inventory + orders.init + xhelpers item ids
--   1 nav        rescan timing/obstacle counts, GridNav parity sanity,
--                fountain->mid path (length/waypoints/ms), tree-walking branch
--   2 mapping    Enum.UnitOrder values used by the new scripts vs orders.ORDER
--   3 purchase   buy a cheap item by definition id (shop.lua:844 semantics:
--                target=id, ability=id), then verify gold changed + item is in
--                the inventory => proves the type=16 pipeline end to end
--   4 move       issue move orders along a planned path, sample hero position
--                every 120ms => displacement per second, stalls, tree-cell hits
--   5 obstacle   goal inside a tree: path endpoint must snap walkable, order
--                must not leave the hero standing still > 2.5s
--   6 attack     attack-target order record (engine CUnitOrders echo check)
--   7 cast A/B   ONLY if D:\hake\lotus\diag_cast.txt exists: no-target cast with
--                ability entity index vs ability slot index (encoding proof)
--   8 summary    PASS/FAIL lines
--
-- Exit: returns after ~25-40s. Keep calls cheap; no loops without Sleep.

package.path = "D:\\hake\\lotus\\src\\?.lua;" .. package.path
local ffi = require("ffi")
ffi.cdef[[ void Sleep(unsigned long ms); ]]
local function sleep(ms) ffi.C.Sleep(ms) end

local logf = io.open("D:\\hake\\lotus\\host.log", "a")
local function log(...)
  local t = {}
  for i = 1, select("#", ...) do t[i] = tostring(select(i, ...)) end
  logf:write(os.date("%H:%M:%S ") .. "[DIAG-ORD]\t" .. table.concat(t, " ") .. "\n")
  logf:flush()
end

local results = {}
local function check(name, cond, extra)
  local ok = cond and true or false
  results[#results + 1] = { name = name, ok = ok, extra = extra }
  log(string.format("%s %s%s", ok and "PASS" or "FAIL", name, extra and (" | " .. extra) or ""))
  return ok
end

