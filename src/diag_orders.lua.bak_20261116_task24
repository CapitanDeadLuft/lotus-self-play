      local entOK = castWith("entity")
      local slotOK = false
      if not entOK then slotOK = castWith("slot") end
      orders.setAbilityEncoding("entity")
      log(string.format("cast encoding verdict: entityIndex=%s slotIndex=%s",
        tostring(entOK), tostring(slotOK)))
      check("cast encoding: one mode works", entOK or slotOK,
        string.format("entity=%s slot=%s", tostring(entOK), tostring(slotOK)))
    end
  end
end

