-- 3. purchase pipeline (P0-C) ---------------------------------------------
-- Reference call site self_play/shop.lua:844:
--   Player.PrepareUnitOrders(player, PURCHASE_ITEM, itemId, Vector(0,0,0), itemId,
--     ISSUER_PASSED_UNIT_ONLY, buyer, false,false,false,true,"self_play_purchase",false)
-- i.e. item DEFINITION id is passed as BOTH targetIndex and abilityIndex.
local function itemIds()
  local map = {}
  if xh and xh.xkv then
    local ok, kv = pcall(function() return xh.xkv:GetKV("items").DOTAAbilities end)
    if ok and kv then
      for k, v in pairs(kv) do
        if type(v) == "table" and v.ID and k:sub(1, 5) == "item_" then
          map[k:sub(6)] = tonumber(v.ID)
        end
      end
    end
  end
  return map
end
local ids = itemIds()
log("item ids loaded=" .. (function() local n = 0; for _ in pairs(ids) do n = n + 1 end; return n end)())

do
