  _G.Enum = _G.Enum or { UnitOrder = orders.ORDER, OrderIssuer = orders.ISSUER }
  _G.Vector = _G.Vector or function(x, y, z) return { x = x or 0, y = y or 0, z = z or 0 } end
  log("api.register: core namespaces registered")
end

